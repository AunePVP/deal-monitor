    </script><script type="text/javascript" data-hid="marketingChannel">
        var sslpVisitDataLayerTimeout = 2000;

        /**
         * @desc This function is used in an intervals in order to check if the mktTrack and mktSession cookies value
         * changes, in this case it performs a push into dataLayer object with the new value.
         * @post If the push is done, the interval is stoped.
         */
        function mktCookiesUpdate(cookie) {
            var mktTrackMatch = cookie.match(/(?:^|;\s*)mktTrack=([^;]+)/);
            var mktSessionMatch = cookie.match(/(?:^|;\s*)mktSession=([^;]+)/);
            if (mktTrackMatch) pushMktTrack(mktTrackMatch[1]);
            if (mktSessionMatch) pushMktSession(mktSessionMatch[1]);
        }

        function pushMktTrack(mktTrack) {
            waitForVisitDataLayer(function() {
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({'event': 'mkttrack', 'mktTrack': mktTrack});
            });
        }

        function pushMktSession(mktSession) {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({'event': 'mktSession', 'mktsession_id': mktSession});
        }

        function waitForVisitDataLayer(callback) {
            var startTime = Date.now();
            var finish = function() {
                callback();
            };
            var waitForPromise = function() {
                var visitDataLayerReady = window.sslpVisitDataLayerReady;
                var elapsedTime = Date.now() - startTime;
                var remainingTime = sslpVisitDataLayerTimeout - elapsedTime;

                if (visitDataLayerReady && typeof visitDataLayerReady.then === 'function') {
                    var completed = false;
                    var resolveOnce = function() {
                        if (completed) {
                            return;
                        }
                        completed = true;
                        clearTimeout(timeoutId);
                        finish();
                    };
                    var timeoutId = setTimeout(resolveOnce, Math.max(0, remainingTime));
                    visitDataLayerReady.then(resolveOnce).catch(resolveOnce);
                    return;
                }

                if (remainingTime <= 0) {
                    finish();
                    return;
                }

                setTimeout(waitForPromise, 50);
            };

            waitForPromise();
        }

        function doTrack() {
            var mktportal = cookies["mktportal"] === undefined ? "" : cookies["mktportal"];
            track('DE', mktportal, 'SSLP', false, mktCookiesUpdate);
        }

        function loadScript(src, callback) {
            var a = document.createElement('script'),
                f = document.getElementsByTagName('head')[0];

            a.async = true;
            a.type = 'text/javascript';
            a.src = src;

            if (callback !== null){
                if (a.readyState) { // IE, incl. IE9
                    a.onreadystatechange = function() {
                        if (a.readyState == "loaded" || a.readyState == "complete") {
                            a.onreadystatechange = null;
                            callback();
                        }
                    };
                } else {
                    a.onload = function() { // Other browsers
                        callback();
                    };
                }
            }

            f.appendChild(a);
        }
