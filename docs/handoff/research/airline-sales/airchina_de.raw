</div> </section> </div> </section> <section class="cav2-right-panel-parent"> <div class="cav2-right-panel cav2-home-sidepanel cav2-home-sidepanel-cabin" style="display:none" tabindex="0"> </div> </section> <section class="cav2-right-panel-parent"> <div class="cav2-right-panel cav2-flightselector cav2-flightstatus-tab-sidepanel" id="flightSearchFormSPanel3" style="display: none"> <h1 class="cav2-right-panel-heading cav2-right-panel-heading-from">Wo soll Ihre Reise beginnen?</h1> <h1 class="cav2-right-panel-heading cav2-right-panel-heading-to">Wohin möchten Sie reisen?</h1> </div> </section> </section> <section class="cav2-flight-deals" >                              <script type="text/javascript"> $(document).ready(function() { var dealsCount = $('.ca-v2-header__flight_deals > .ca-v2-header__flight_deals_inner:visible').not('.ca-v2-header__flight_deals_inner_1').find('#destinationDealsCount').val(); $('.ca-v2-header__flight_deals_inner_1 .ca-v2-header__flight_deals_cards_b').removeClass('one two three'); if(dealsCount == 1) { $('.ca-v2-header__flight_deals .ca-v2-header__flight_deals_inner_1 .ca-v2-header__flight_deals_cards_b').addClass('one'); } else if(dealsCount > 1 && dealsCount < 5) { $('.ca-v2-header__flight_deals .ca-v2-header__flight_deals_inner_1 .ca-v2-header__flight_deals_cards_b').addClass('two'); } else { $('.ca-v2-header__flight_deals .ca-v2-header__flight_deals_inner_1 .ca-v2-header__flight_deals_cards_b').addClass('three'); } }); </script>
