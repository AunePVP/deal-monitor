<style id="wp-custom-css">.pf-flight-request-link {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
}
h3 {
  margin-bottom: 0.5em;
}
.entry-content pre {
	  margin-top: 0.5em;
  margin-bottom: 0.9em;
}
.entry-content h2 {
  margin-bottom: 0.7em;
}

h3 {
  margin-bottom: 0.5em;
}
/* =========================================================
   PREMIUM FLIGHTS - PRIORITY PASS ARTICLE
   ========================================================= */


/* ---------- Highlight Offer Box ---------- */

.pf-highlight-box {
    position: relative;
    margin: 30px 0;
    padding: 32px 30px 28px;
    background: #f5f8fb;
    border: 1px solid #dce4ec;
    border-left: 5px solid #1e73be;
    border-radius: 8px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
}

.pf-highlight-box .pf-box-label {
    display: inline-block;
    margin-bottom: 12px;
    padding: 5px 10px;
    background: #1e73be;
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    border-radius: 4px;
}

.pf-highlight-box h2 {
    margin: 0 0 12px;
    padding: 0;
    font-size: 26px;
    line-height: 1.25;
}

.pf-highlight-box .pf-box-button {
    display: inline-block;
    margin-top: 20px;
    padding: 12px 22px;
    background: #1e73be;
    color: #ffffff !important;
    font-weight: 700;
    text-decoration: none !important;
    border-radius: 5px;
    transition: background 0.2s ease, transform 0.2s ease;
}

.pf-highlight-box .pf-box-button:hover {
    background: #155a96;
    color: #ffffff !important;
    transform: translateY(-1px);
}


/* ---------- Benefits Box ---------- */

.pf-benefits-box {
    margin: 28px 0;
    padding: 24px 26px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}

.pf-benefits-box h3 {
    margin: 0 0 14px;
    font-size: 21px;
}

.pf-benefits-box ul {
    margin: 0;
    padding-left: 22px;
}

.pf-benefits-box li {
    margin-bottom: 8px;
}

.pf-benefits-box li:last-child {
    margin-bottom: 0;
}


/* ---------- Membership Plan Grid ---------- */

.pf-plan-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    margin: 30px 0;
    align-items: stretch;
}


/* ---------- Membership Cards ---------- */

.pf-plan-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 28px 24px 24px;
    background: #ffffff;
    border: 1px solid #dce4ec;
    border-radius: 10px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
}

.pf-plan-card h3 {
    margin: 12px 0 4px;
    font-size: 24px;
    line-height: 1.2;
}

.pf-plan-description {
    margin: 0 0 18px;
    color: #5b6570;
    font-size: 14px;
}

.pf-plan-price {
    margin: 0 0 20px;
    line-height: 1.35;
}

.pf-plan-price strong {
    display: block;
    margin-top: 3px;
    font-size: 24px;
    line-height: 1.25;
}

.pf-old-price {
    display: block;
    color: #7b8490;
    font-size: 15px;
    text-decoration: line-through;
}

.pf-plan-card ul {
    margin: 0 0 20px;
    padding-left: 21px;
}

.pf-plan-card li {
    margin-bottom: 8px;
}

.pf-plan-card > strong {
    display: block;
    margin-top: auto;
    padding-top: 4px;
}


/* ---------- Featured Plan ---------- */

.pf-plan-card.pf-plan-featured {
    border: 2px solid #1e73be;
    box-shadow: 0 7px 20px rgba(30, 115, 190, 0.14);
}


/* ---------- Discount Badge ---------- */

.pf-discount-badge {
    display: inline-block;
    align-self: flex-start;
    padding: 5px 9px;
    background: #eaf3fb;
    color: #155a96;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    border-radius: 4px;
}


/* ---------- Recommended Badge ---------- */

.pf-recommended-badge {
    margin: -28px -24px 16px;
    padding: 9px 12px;
    background: #1e73be;
    color: #ffffff;
    text-align: center;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    border-radius: 8px 8px 0 0;
}


/* ---------- Plan Buttons ---------- */

.pf-plan-button {
    display: block;
    margin-top: 22px;
    padding: 12px 16px;
    background: #1e73be;
    color: #ffffff !important;
    text-align: center;
    font-weight: 700;
    text-decoration: none !important;
    border-radius: 5px;
    transition: background 0.2s ease, transform 0.2s ease;
}

.pf-plan-button:hover {
    background: #155a96;
    color: #ffffff !important;
    transform: translateY(-1px);
}


/* ---------- Small Print ---------- */

.pf-small-print {
    margin: 10px 0 28px;
    padding: 14px 16px;
    background: #f7f7f7;
    color: #5d6670;
    font-size: 13px;
    line-height: 1.55;
    border-radius: 6px;
}


/* ---------- Comparison Box ---------- */

.pf-comparison-box {
    margin: 28px 0;
    padding: 25px 26px;
    background: #f8fafc;
    border: 1px solid #dfe5eb;
    border-radius: 8px;
}

.pf-comparison-box h3 {
    margin: 0 0 16px;
    font-size: 21px;
}

.pf-comparison-row {
    padding: 14px 0;
    border-bottom: 1px solid #dde4ea;
    line-height: 1.5;
}

.pf-comparison-row:first-of-type {
    padding-top: 4px;
}

.pf-comparison-row:last-child {
    padding-bottom: 0;
    border-bottom: 0;
}

.pf-comparison-row strong {
    display: block;
    margin-bottom: 3px;
}


/* ---------- Example Box ---------- */

.pf-example-box {
    margin: 28px 0;
    padding: 24px 26px;
    background: #f4f8fc;
    border-left: 4px solid #1e73be;
    border-radius: 6px;
}

.pf-example-box h3 {
    margin: 0 0 12px;
    font-size: 21px;
}

.pf-example-box p:last-child {
    margin-bottom: 0;
}


/* ---------- Info Box ---------- */

.pf-info-box {
    margin: 28px 0;
    padding: 24px 26px;
    background: #eef7ff;
    border: 1px solid #cfe6fa;
    border-left: 4px solid #1e73be;
    border-radius: 6px;
}

.pf-info-box h3 {
    margin: 0 0 10px;
    font-size: 21px;
}

.pf-info-box p:last-child {
    margin-bottom: 0;
}


/* ---------- Warning Box ---------- */

.pf-warning-box {
    margin: 28px 0;
    padding: 24px 26px;
    background: #fffaf0;
    border: 1px solid #eedda8;
    border-left: 4px solid #d49b17;
    border-radius: 6px;
}

.pf-warning-box h3 {
    margin: 0 0 14px;
    font-size: 21px;
}

.pf-warning-box ul {
    margin: 0;
    padding-left: 22px;
}

.pf-warning-box li {
    margin-bottom: 9px;
}

.pf-warning-box li:last-child {
    margin-bottom: 0;
}


/* ---------- Final CTA Box ---------- */

.pf-final-box {
    margin: 35px 0 20px;
    padding: 32px 30px;
    background: #f5f8fb;
    border: 1px solid #d9e3ec;
    border-radius: 9px;
    text-align: center;
}

.pf-final-box h2 {
    margin: 0 0 12px;
    padding: 0;
    font-size: 26px;
}

.pf-final-box p {
    margin-bottom: 0;
}


/* ---------- Final CTA Button ---------- */

.pf-final-button {
    display: inline-block;
    margin-top: 20px;
    padding: 13px 24px;
    background: #1e73be;
    color: #ffffff !important;
    font-weight: 700;
    text-decoration: none !important;
    border-radius: 5px;
    transition: background 0.2s ease, transform 0.2s ease;
}

.pf-final-button:hover {
    background: #155a96;
    color: #ffffff !important;
    transform: translateY(-1px);
}


/* ---------- General Box Paragraph Spacing ---------- */

.pf-highlight-box p:last-child,
.pf-benefits-box p:last-child,
.pf-comparison-box p:last-child,
.pf-example-box p:last-child,
.pf-info-box p:last-child,
.pf-warning-box p:last-child,
.pf-final-box p:last-child {
    margin-bottom: 0;
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

    .pf-plan-grid {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .pf-plan-card {
        max-width: 620px;
        width: 100%;
        margin-left: auto;
        margin-right: auto;
        box-sizing: border-box;
    }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 600px) {

    .pf-highlight-box,
    .pf-benefits-box,
    .pf-comparison-box,
    .pf-example-box,
    .pf-info-box,
    .pf-warning-box,
    .pf-final-box {
        margin: 24px 0;
        padding: 22px 18px;
    }

    .pf-highlight-box {
        padding-top: 24px;
    }

    .pf-highlight-box h2,
    .pf-final-box h2 {
        font-size: 22px;
    }

    .pf-benefits-box h3,
    .pf-comparison-box h3,
    .pf-example-box h3,
    .pf-info-box h3,
    .pf-warning-box h3 {
        font-size: 19px;
    }

    .pf-plan-grid {
        margin: 24px 0;
        gap: 18px;
    }

    .pf-plan-card {
        padding: 24px 19px 20px;
    }

    .pf-plan-card h3 {
        font-size: 22px;
    }

    .pf-plan-price strong {
        font-size: 22px;
    }

    .pf-recommended-badge {
        margin: -24px -19px 15px;
    }

    .pf-highlight-box .pf-box-button,
    .pf-plan-button,
    .pf-final-button {
        display: block;
        width: 100%;
        box-sizing: border-box;
        text-align: center;
    }

}
html {
    scroll-padding-top: 100px;
}
.pf-kofi-support {
    margin: 28px 0 12px;
    text-align: center;
}

.pf-kofi-support h3 {
    margin: 0 0 5px;
    font-size: 18px;
}

.pf-kofi-support p {
    margin: 0 auto 10px;
    max-width: 560px;
    line-height: 1.45;
}

.pf-kofi-support iframe {
    display: block;
    width: 100%;
    max-width: 430px;
    height: 500px;
    margin: 0 auto;
    border: 0;
}
.pf-kofi-support h3 {
    font-weight: 700;
}
/* =========================================================
   PREMIUM-FLIGHTS — SINGLE POST TITLE + FEATURED IMAGE
   ========================================================= */

/* ---------- DESKTOP ---------- */

/* Smaller post title */
body.single-post .pf-article > h1 {
    max-width: 850px !important;
    margin: 0 auto 10px !important;
    text-align: center !important;
    font-size: clamp(28px, 2.15vw, 35px) !important;
    line-height: 1.15 !important;
}

/* Keep publication date centered */
body.single-post .pf-article > .pf-card__meta {
    text-align: center !important;
    margin-bottom: 18px !important;
}

/* Make featured image slightly smaller */
body.single-post .pf-article > .pf-featured {
    width: 95% !important;
    max-width: 880px !important;
    margin: 0 auto 22px !important;
}

/* Featured image itself */
body.single-post .pf-article > .pf-featured img {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    margin: 0 !important;
}


/* ---------- TABLET ---------- */

@media (max-width: 900px) {

    body.single-post .pf-article > h1 {
        max-width: 760px !important;
        font-size: clamp(27px, 4.2vw, 34px) !important;
        line-height: 1.15 !important;
    }

    body.single-post .pf-article > .pf-featured {
        width: 94% !important;
        max-width: 760px !important;
    }
}


/* ---------- MOBILE ---------- */

@media (max-width: 700px) {

    body.single-post .pf-article > h1 {
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 auto 10px !important;
        font-size: clamp(24px, 6.5vw, 29px) !important;
        line-height: 1.13 !important;
    }

    body.single-post .pf-article > .pf-featured {
        width: 100% !important;
        max-width: none !important;
        margin: 0 auto 18px !important;
    }

    body.single-post .pf-article > .pf-featured img {
        width: 100% !important;
        height: auto !important;
    }
}


/* ---------- SMALL MOBILE ---------- */

@media (max-width: 480px) {

    body.single-post .pf-article > h1 {
        font-size: 25px !important;
        line-height: 1.14 !important;
    }
}

/* =========================================================
   PREMIUM-FLIGHTS - FLIGHT REQUEST (CLEAN REPLACEMENT)
   Scoped to .pf-flight-request only
   ========================================================= */

.pf-flight-request {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    color: #17233b;
}

.pf-flight-request *,
.pf-flight-request *::before,
.pf-flight-request *::after {
    box-sizing: border-box;
}

/* CF7/WordPress sometimes injects line breaks and paragraphs
   around form controls. Remove their vertical layout effects. */
.pf-flight-request .pf-field br,
.pf-flight-request .pf-request-grid > br {
    display: none !important;
}

.pf-flight-request .pf-field p,
.pf-flight-request .pf-request-grid > p {
    margin: 0 !important;
    padding: 0 !important;
    line-height: inherit;
}

.pf-flight-request .pf-field p:empty,
.pf-flight-request .pf-request-grid > p:empty {
    display: none !important;
}

/* Section headings */
.pf-flight-request h3 {
    margin: 20px 0 12px !important;
    padding: 0 !important;
    font-size: 19px;
    font-weight: 500;
    line-height: 1.3;
    color: #17233b;
}

/* Rows */
.pf-flight-request .pf-request-grid {
    display: grid !important;
    width: 100%;
    grid-template-columns: 1fr;
    gap: 12px 16px !important;
    align-items: end;
    padding: 0 !important;
    margin: 0 0 14px !important;
}

.pf-flight-request .pf-request-grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.pf-flight-request .pf-request-grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

/* Each label sits immediately above its field. Using bottom
   alignment keeps the inputs aligned when one label wraps. */
.pf-flight-request .pf-field {
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-end !important;
    align-items: stretch !important;
    gap: 4px !important;
    min-width: 0;
    margin: 0 !important;
    padding: 0 !important;
}

.pf-flight-request .pf-field > label {
    display: block !important;
    width: 100%;
    height: auto !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    font-size: 14px;
    line-height: 1.35 !important;
    font-weight: 400;
    color: #17233b;
}

.pf-flight-request .pf-field > label span {
    color: inherit;
}

.pf-flight-request .pf-field > label small {
    font-size: 12px;
}

/* Wrap generated by Contact Form 7 */
.pf-flight-request .pf-field .wpcf7-form-control-wrap {
    display: block !important;
    width: 100%;
    min-width: 0;
    margin: 0 !important;
    padding: 0 !important;
    line-height: normal !important;
}

/* All standard controls */
.pf-flight-request .pf-field input:not([type="checkbox"]),
.pf-flight-request .pf-field select,
.pf-flight-request .pf-field textarea {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    border: 1px solid #bfc2c8;
    border-radius: 4px;
    background: #fff;
    color: #252525;
    box-shadow: none;
    font-size: 14px;
    font-weight: 400;
}

.pf-flight-request .pf-field input:not([type="checkbox"]),
.pf-flight-request .pf-field select {
    height: 42px !important;
    min-height: 42px !important;
    padding: 8px 11px !important;
    line-height: 24px !important;
}

.pf-flight-request .pf-field input::placeholder,
.pf-flight-request .pf-field textarea::placeholder {
    color: #929dad;
    opacity: 1;
}

.pf-flight-request .pf-field input:focus,
.pf-flight-request .pf-field select:focus,
.pf-flight-request .pf-field textarea:focus {
    border-color: #2862e9;
    outline: none;
    box-shadow: 0 0 0 2px rgba(40, 98, 233, 0.12);
}

.pf-flight-request .pf-positioning-field {
    margin: 0 0 14px !important;
}

.pf-flight-request .pf-notes-field {
    margin: 2px 0 12px !important;
}

.pf-flight-request .pf-notes-field textarea {
    height: 140px !important;
    min-height: 140px !important;
    padding: 11px !important;
    line-height: 1.5;
    resize: vertical;
}

/* Dark informational boxes */
.pf-flight-request .pf-departure-help {
    margin: 12px 0 16px !important;
    padding: 16px !important;
    border-radius: 6px;
    background: #172137;
    color: #fff;
    font-size: 13px;
    line-height: 1.6;
}

.pf-flight-request .pf-departure-help strong,
.pf-flight-request .pf-departure-help li {
    color: #fff;
}

.pf-flight-request .pf-departure-help p {
    margin: 6px 0 !important;
    padding: 0 !important;
    color: #fff;
    font-size: inherit;
    line-height: inherit;
}

.pf-flight-request .pf-departure-help p:last-child {
    margin-bottom: 0 !important;
}

.pf-flight-request .pf-departure-help ol {
    margin: 8px 0 10px 20px !important;
    padding: 0 !important;
}

.pf-flight-request .pf-departure-help li {
    margin-bottom: 5px;
}

.pf-flight-request .pf-departure-help a {
    color: #a9cbff;
    text-decoration: underline;
}

.pf-flight-request .pf-travel-tip {
    margin: 8px 0 14px !important;
}

.pf-flight-request .pf-important-info {
    margin: 12px 0 16px !important;
}

/* Consent and security details */
.pf-flight-request .pf-request-consent {
    margin: 14px 0 !important;
    font-size: 13px;
    line-height: 1.5;
}

.pf-flight-request .pf-request-consent p {
    margin: 0 !important;
}

.pf-flight-request .pf-request-security {
    margin: 12px 0 16px !important;
}

.pf-flight-request .pf-request-security p {
    margin: 6px 0 !important;
}

.pf-flight-request input[type="submit"] {
    margin-top: 4px !important;
    cursor: pointer;
}

.pf-flight-request .pf-request-required {
    margin: 10px 0 0 !important;
    font-size: 12px;
}

/* Tablet */
@media (max-width: 850px) {
    .pf-flight-request .pf-request-grid--3 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

/* Mobile */
@media (max-width: 600px) {
    .pf-flight-request .pf-request-grid--2,
    .pf-flight-request .pf-request-grid--3 {
        grid-template-columns: 1fr;
    }

    .pf-flight-request .pf-request-grid {
        gap: 12px !important;
        margin-bottom: 14px !important;
    }

    .pf-flight-request h3 {
        margin: 19px 0 11px !important;
    }

    .pf-flight-request .pf-departure-help {
        padding: 13px !important;
    }
}

/* =========================================
   PF FLIGHT REQUEST – SPACING FIX
   ========================================= */

/* Remove unwanted CF7 paragraph spacing */
.pf-flight-request .pf-request-grid > p,
.pf-flight-request .pf-field > p {
    display: contents !important;
}

.pf-flight-request .pf-request-grid br,
.pf-flight-request .pf-field br {
    display: none !important;
}

/* Consistent spacing between rows */
.pf-flight-request .pf-request-grid {
    row-gap: 16px !important;
    column-gap: 16px !important;
    align-items: start !important;
    margin: 0 0 18px !important;
}

/* Keep labels close to inputs */
.pf-flight-request .pf-field {
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    gap: 5px !important;
    margin: 0 !important;
}

.pf-flight-request .pf-field > label {
    margin: 0 !important;
    padding: 0 !important;
    line-height: 1.35 !important;
}

/* Remove spacing around CF7 controls */
.pf-flight-request .wpcf7-form-control-wrap {
    margin: 0 !important;
    padding: 0 !important;
}

.pf-flight-request .pf-field input,
.pf-flight-request .pf-field select {
    margin: 0 !important;
}

/* Section headings */
.pf-flight-request h3 {
    margin: 24px 0 14px !important;
}

/* Informational boxes */
.pf-flight-request .pf-departure-help {
    margin: 14px 0 20px !important;
}

/* Mobile */
@media (max-width: 600px) {
    .pf-flight-request .pf-request-grid {
        row-gap: 14px !important;
    }
}</style></head><body class="error404 wp-theme-premium-flights-custom"><div class="pf-site"><header class="pf-header"><div class="pf-hero"><div class="pf-hero__inner"><div class="pf-branding">
