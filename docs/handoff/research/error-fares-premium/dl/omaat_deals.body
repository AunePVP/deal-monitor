		<script>
			window.googletag = window.googletag || {cmd: []};

			var gptAdSlots = gptAdSlots || {};

			window.omaatAds = window.omaatAds || {};

					window.omaatAds.desktopSizes = {
			'ATFBillboard': [[970, 90], [728, 90]],
			'ATFleaderboard': [[970, 90], [728, 90]],
			'AdhesionLeaderboard': [728, 90],
			'inGrid': [300, 250],
			'inContent': [300, 250], // Track B (B11): 728x90 no longer fits the 600-720px content column.
			'rail1': [300, 250], // Rail v4: rail ad segments (historical aside slot first).
			'rail2': [300, 250],
			'rail3': [300, 250],
			'rail4': [300, 250],
			'left': [160, 600],  // Rail v3: the left-column unit, >= LEFT_RAIL_BREAKPOINT only.
			// Rail v2: 'inComments' retired ($23/month). The in-comments divs are hidden by _ad.scss.
		}
		window.omaatAds.tabletSizes = {
			'ATFBillboard': [728, 90],
			'ATFleaderboard': [728, 90],
			'AdhesionLeaderboard': [728, 90],
			'inGrid': [300, 250],
			'inContent': [[728, 90], [300, 250]],
			// Track B (B11): no 'aside' below the rail breakpoint. The slot is not defined there.
		}
		window.omaatAds.mobileSizes = {
			'ATFBillboard': [[320, 50]],
			'ATFleaderboard': [[320, 50]],
			'AdhesionLeaderboard': [320, 50],
			'inGrid': [300, 250],
			'inContent': [300, 250], // Rail v2: was [320, 50]. Height reserved in _ad.scss.
			// Track B (B11): no 'aside' below the rail breakpoint. The slot is not defined there.
		}

		window.omaatAds.railBreakpoint = 1050;
		window.omaatAds.hasRail = window.matchMedia('(min-width: ' + window.omaatAds.railBreakpoint + 'px)').matches;
		// Step 110: left rail. The aside is a 160x600 there, a 300x250 in the right rail otherwise.
		window.omaatAds.leftRailBreakpoint = 1400;
		window.omaatAds.hasLeftRail = window.matchMedia('(min-width: ' + window.omaatAds.leftRailBreakpoint + 'px)').matches;

		window.omaatAds.getAdSizes = function(slotName) {
			var sizes = [];
			if (window.omaatAds.hasRail) {
				sizes = window.omaatAds.desktopSizes[slotName] || sizes;
			} else if (window.matchMedia('(min-width: 768px)').matches) {
				sizes = window.omaatAds.tabletSizes[slotName] || sizes;
			} else {
				sizes = window.omaatAds.mobileSizes[slotName] || sizes;
			}
			return sizes;
		}
		
			googletag.cmd.push(function() {
						// Step 108: on single posts the billboard box is display:none below 768px
		// (_ad.scss, .single-post .ad--leaderboard), so there the slot exists only from
		// 768px up — no request into a hidden container. Every other page: all widths.
		window.omaatAds.postBillboard = false;
		if (!window.omaatAds.postBillboard || window.matchMedia('(min-width: 768px)').matches) {
			gptAdSlots['atfbillboard'] = googletag.defineSlot(
				'/1019006/OMAAT_ATFBillboard',
				window.omaatAds.getAdSizes('ATFBillboard'),
				'div-gpt-ad-1611951154866-0')
				.addService(googletag.pubads());
		}

		// Step 102: on the post templates (page_has_rail) the under-hero leaderboard is
		// desktop-only, so its slot exists only at rail widths — same rule as the rail
		// ads. Everywhere else (the editor ad block on pages) it is defined at every width.
		window.omaatAds.postLeaderboard = false;
		if (!window.omaatAds.postLeaderboard || window.omaatAds.hasRail) {
			gptAdSlots['atfleaderboard'] = googletag.defineSlot(
				'/1019006/OMAAT_ATFLeaderboard',
				window.omaatAds.getAdSizes('ATFleaderboard'),
				'div-gpt-ad-1611951154866-1')
				.addService(googletag.pubads());
		}

		gptAdSlots['adhesionleaderboard'] = googletag.defineSlot(
			'/1019006/OMAAT_AdhesionLeaderboard',
			window.omaatAds.getAdSizes('AdhesionLeaderboard'),
			'div-gpt-ad-1611951154866-2')
			.setTargeting('refresh', 'true')
			.addService(googletag.pubads());

		// Rail v4 (Step 114): OMAAT_Aside instances. 'rail1' (historical id, first
		// segment under the video) and 'left' have their divs at load, so they are
		// defined here; 'rail2'..'rail4' get their div and their definition from
		// src/js/rail when their segment comes into view. refresh=true lets the
		// header-bidding wrapper re-auction a unit 30s after a viewable impression.
		window.omaatAds.railAdUnit = "\/1019006\/OMAAT_Aside";
		window.omaatAds.railSlots = [];
		if (window.omaatAds.hasRail && window.omaatAds.railSlots.rail1) {
			gptAdSlots['rail1'] = googletag.defineSlot(
				window.omaatAds.railAdUnit,
				window.omaatAds.getAdSizes('rail1'),
				window.omaatAds.railSlots.rail1)
				.setTargeting('position', 'rail1')
				.setTargeting('refresh', 'true')
				.addService(googletag.pubads());
		}
		if (window.omaatAds.hasLeftRail && window.omaatAds.railSlots.left) {
			gptAdSlots['left'] = googletag.defineSlot(
				window.omaatAds.railAdUnit,
				window.omaatAds.getAdSizes('left'),
				window.omaatAds.railSlots.left)
				.setTargeting('position', 'left')
				.setTargeting('refresh', 'true')
				.addService(googletag.pubads());
		}
		googletag.pubads().setTargeting("test", "true");
googletag.pubads().setTargeting("blogname", "onemileatatime");
googletag.pubads().setTargeting("canonicalURL", "");

				googletag.pubads().enableSingleRequest();
				googletag.pubads().disableInitialLoad();
				googletag.pubads().setCentering(true);
				googletag.enableServices();
			});
		</script>
