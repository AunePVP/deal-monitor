<style>

/* ======================================
   BASE / DESKTOP
====================================== */

.newsletter-grid-signup {
    position: relative;

    width: 100%;
    height: 100%;

    background-image: url('/assets/images/newsletter/sign-up-14.jpg');
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;

    border-radius: 8px;
    overflow: hidden;

    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.12);
}


/* Form fills the card */
.newsletter-grid-form {
    width: 100%;
    height: 100%;

    margin: 0;
}


/* Main content */
.newsletter-grid-content {
    width: 100%;
    height: 100%;

    padding: 22px 20px;

    display: flex;
    flex-direction: column;

    color: #fff;
}


/* Heading */
.newsletter-grid-content h5 {
    margin: 0 0 14px;

    color: #fff !important;

    font-size: 28px;
    font-weight: 600;
    line-height: 1.05;

    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4);
}


/* Description */
.newsletter-grid-description {
    max-width: 100%;

    margin: 0 auto;

    color: #fff !important;

    font-size: 16px;
    line-height: 1.25;

    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
}

.newsletter-grid-description span {
    display: block;
    white-space: nowrap;
}


/*
    Push fields toward the bottom of the card.
*/
.newsletter-grid-fields {
    width: 100%;

    margin-top: auto;
}


/* Inputs */
.newsletter-grid-fields .form-control {
    width: 100%;
    height: 36px;

    margin-bottom: 14px;

    padding: 0 18px;

    border: none !important;
    border-radius: 10px;

    background: #fff;

    color: #555 !important;

    font-size: 17px;

    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.14);
}


.newsletter-grid-fields .form-control::placeholder {
    color: #777;
    opacity: 1;
}


.newsletter-grid-fields .form-control:focus {
    outline: none;

    border: none !important;

    box-shadow:
        0 0 0 2px rgba(230, 185, 62, 0.55),
        0 2px 5px rgba(0, 0, 0, 0.14);
}


/* Yellow button */
.newsletter-grid-button {
    display: block;

    width: 100%;
    min-height: 36px;

    margin: 4px auto 0;

    padding: 8px 14px;

    border: 0;
    border-radius: 8px;

    background: #e7b93e;
    color: #07133d;

    font-size: 18px;
    font-weight: 700;

    cursor: pointer;

    transition: background-color 0.2s ease;
}


.newsletter-grid-button:hover {
    background: #efc64a;
}


/* POT */
.newsletter-pot {
    position: absolute !important;

    left: -9999px !important;
    top: -9999px !important;

    width: 1px !important;
    height: 1px !important;

    overflow: hidden !important;
}


/* Validation */
label.error {
    color: #ffb3b3 !important;
}


.error {
    border: 2px solid #dc3545 !important;
}



/* ======================================
   TABLET ONLY
   769px - 991px
====================================== */

@media (min-width: 769px) and (max-width: 991px) {

    .newsletter-grid-signup {
        height: 100%;
        min-height: 0;
    }


    .newsletter-grid-form {
        height: 100%;
        min-height: 0;
    }


    .newsletter-grid-content {
        height: 100%;
        min-height: 0;

        padding: 22px 18px 18px;
    }


    .newsletter-grid-content h5 {
        font-size: 25px;
        line-height: 1.05;

        margin-bottom: 16px;
    }


    .newsletter-grid-description {
        font-size: 14px;
        line-height: 1.2;
    }


    .newsletter-grid-fields {
        margin-top: auto;
    }


    .newsletter-grid-fields .form-control {
        height: 48px;

        margin-bottom: 10px;

        padding: 0 15px;

        font-size: 14px;
    }


    .newsletter-grid-button {
        min-height: 48px;

        margin-top: 2px;

        font-size: 14px;
    }
}



/* ======================================
   MOBILE
   768px and below
====================================== */

@media (max-width: 768px) {

    /*
        Important:
        Fixed compact card height for mobile.
        No 650px / giant banner.
    */
    .newsletter-grid-signup {
        height: 430px;
        min-height: 0;

        background-size: cover;
        background-position: center center;
    }


    .newsletter-grid-form {
        width: 100%;
        height: 100%;
        min-height: 0;
    }


    .newsletter-grid-content {
        width: 100%;
        height: 100%;
        min-height: 0;

        padding: 20px 20px 18px;

        display: flex;
        flex-direction: column;
    }


    .newsletter-grid-content h5 {
        margin: 0 0 10px;

        font-size: 26px;
        font-weight: 600;
        line-height: 1;

        color: #fff !important;
    }


    .newsletter-grid-description {
        max-width: 100%;

        margin: 0 auto;

        font-size: 14px;
        line-height: 1.2;

        color: #fff !important;
    }


    /*
        Automatically uses remaining vertical space.
        No margin-bottom: 180px.
    */
    .newsletter-grid-fields {
        width: 100%;

        margin-top: auto;
    }


    .newsletter-grid-fields .form-control {
        width: 100%;
        height: 48px;

        margin-bottom: 10px;

        padding: 0 16px;

        border-radius: 9px;

        font-size: 15px;
    }


    .newsletter-grid-button {
        width: 100%;
        min-height: 48px;

        margin: 2px auto 0;

        padding: 8px 12px;

        border-radius: 8px;

        font-size: 15px;
    }
}



/* ======================================
   SMALL MOBILE
====================================== */

@media (max-width: 480px) {

    .newsletter-grid-signup {
        height: 400px;
    }


    .newsletter-grid-content {
        padding: 16px 16px 14px;
    }


    .newsletter-grid-content h5 {
        font-size: 26px;
        line-height: 1;

        margin-bottom: 16px;
    }


    .newsletter-grid-description {
        max-width: 100%;

        font-size: 14px;
        line-height: 1.2;
    }


    .newsletter-grid-fields .form-control {
        height: 36px;

        margin-bottom: 9px;

        padding: 0 14px;

        font-size: 14px;

        border-radius: 8px;
    }


    .newsletter-grid-button {
        min-height: 36px;

        padding: 7px 10px;

        font-size: 14px;

        border-radius: 8px;
    }
}

