,"region":[19080],"destinations":[1710,2157,673,2238,2290,3103,892,109],"origins":[3087,3174,3614,40172,25319,3058,3641],"period":[19087,19098,19085,19084,19097,2173],"visibility":[],"class_list":["post-486641","deal","type-deal","status-publish","format-standard","has-post-thumbnail","hentry","category-kreuzfahrten","tag-all-inclusive","tag-alleinreisende","tag-luxuskreuzfahrten","cruiseline-explora-i","cruiseline-explora-ii","region-all","destinations-athen","destinations-barcelona","destinations-lissabon","destinations-malaga","destinations-marokko","destinations-marseille","destinations-rom","destinations-teneriffa","origins-athen-flughafen","origins-barcelona-bcn","origins-lissabon-flughafen","origins-malaga","origins-marseille","origins-rom-fco","origins-teneriffa","period-april","period-dezember","period-februar","period-januar","period-november","period-osterferien"],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal\/486641","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/types\/deal"}],"author":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/comments?post=486641"}],"version-history":[{"count":10,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal\/486641\/revisions"}],"predecessor-version":[{"id":486728,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal\/486641\/revisions\/486728"}],"wp:attachment":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/media?parent=486641"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/categories?post=486641"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/tags?post=486641"},{"taxonomy":"airline","embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/airline?post=486641"},{"taxonomy":"cruiseline","embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/cruiseline?post=486641"},{"taxonomy":"region","embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/region?post=486641"},{"taxonomy":"destinations","embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/destinations?post=486641"},{"taxonomy":"origins","embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins?post=486641"},{"taxonomy":"period","embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/period?post=486641"},{"taxonomy":"visibility","embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/visibility?post=486641"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":486615,"date":"2026-11-04T13:41:23","date_gmt":"2026-11-04T12:41:23","guid":{"rendered":"https:\/\/travel-dealz.de\/?post_type=deal&#038;p=486615"},"modified":"2026-11-04T17:45:51","modified_gmt":"2026-11-04T16:45:51","slug":"qatar-gabelfluege-down-under","status":"publish","type":"deal","link":"https:\/\/travel-dealz.de\/deal\/qatar-gabelfluege-down-under\/","title":{"rendered":"Qatar Airways: Gabelfl\u00fcge nach Down Under ab 745\u20ac, z.B. Warschau &#8211; Auckland &#8211; M\u00fcnchen"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">Vor ein paar Tagen haben wir auch g\u00fcnstige Gabelfl\u00fcge mit China Eastern vorgestellt: Mit Start von Stockholm und R\u00fcckflug nach Frankfurt gibt es <a href=\"https:\/\/travel-dealz.de\/deal\/china-eastern-gabelfluege-down-under\/\">Tickets ab 528\u20ac<\/a>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u00c4hnlich funktioniert das Ganze auch mit Qatar Airways. Die Preise fallen zwar etwas h\u00f6her aus, daf\u00fcr ist auch der Abflug von Warschau m\u00f6glich, wo sich die Anreise per Bahn anbietet. Die Kombinxation Warschau &#8211; Auckland &#8211; M\u00fcnchen ist beispielsweise ab 755\u20ac buchbar. Noch etwas g\u00fcnstiger geht es von Zagreb nach Perth in Western Australia &#8211; und dann zur\u00fcck nach Z\u00fcrich.<\/p>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"https:\/\/go2.travel-dealz.de\/?type=flights&amp;from%5B0%5D=WAW&amp;to%5B0%5D=AKL&amp;date_out%5B0%5D=2027-05-11&amp;from%5B1%5D=AKl&amp;to%5B1%5D=MUC&amp;date_out%5B1%5D=2027-05-26&amp;oneway=true&amp;cabinclass=Y&amp;direct=false&amp;adults=1&amp;children=0&amp;infants=0%C2%A4cy=EUR&amp;destination=trip.de\" target=\"_blank\" rel=\"nofollow sponsored noopener\">Zum Deal<\/a><\/div>\n<\/div>\n\n\n\n<p class=\"wp-block-paragraph\">Nachfolgend einige Beispiele f\u00fcr Tickets unter 800\u20ac:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Zagreb &#8211; Perth &#8211; Z\u00fcrich <a rel=\"nofollow sponsored noopener\" href=\"https:\/\/go2.travel-dealz.de\/?from%5B0%5D=ZAG&amp;to%5B0%5D=PER&amp;date_out%5B0%5D=2027-03-31&amp;from%5B1%5D=PER&amp;to%5B1%5D=ZRH&amp;date_out%5B1%5D=2027-04-26&amp;oneway=true&amp;cabinclass=Y&amp;direct=false&amp;adults=1&amp;children=0&amp;infants=0&amp;currency=EUR&amp;destination=trip.de\">f\u00fcr 745\u20ac<\/a><\/li>\n\n\n\n<li>Warschau &#8211; Auckland &#8211; M\u00fcnchen <a rel=\"nofollow sponsored noopener\" href=\"https:\/\/go2.travel-dealz.de\/?type=flights&amp;from%5B0%5D=WAW&amp;to%5B0%5D=AKL&amp;date_out%5B0%5D=2027-05-11&amp;from%5B1%5D=AKl&amp;to%5B1%5D=MUC&amp;date_out%5B1%5D=2027-05-26&amp;oneway=true&amp;cabinclass=Y&amp;direct=false&amp;adults=1&amp;children=0&amp;infants=0\u00a4cy=EUR&amp;destination=trip.de\">f\u00fcr 755\u20ac<\/a><\/li>\n\n\n\n<li>Dublin &#8211; Auckland &#8211; M\u00fcnchen <a rel=\"nofollow sponsored noopener\" href=\"https:\/\/go2.travel-dealz.de\/?type=flights&amp;from%5B0%5D=DUB&amp;to%5B0%5D=AKL&amp;date_out%5B0%5D=2027-04-06&amp;from%5B1%5D=AKl&amp;to%5B1%5D=MUC&amp;date_out%5B1%5D=2027-04-27&amp;oneway=true&amp;cabinclass=Y&amp;direct=false&amp;adults=1&amp;children=0&amp;infants=0&amp;currency=EUR&amp;destination=trip.de\">f\u00fcr 765\u20ac<\/a><\/li>\n\n\n\n<li>Barcelona &#8211; Melbourne &#8211; Berlin <a rel=\"nofollow sponsored noopener\" href=\"https:\/\/go2.travel-dealz.de\/?type=flights&amp;from%5B0%5D=BCN&amp;to%5B0%5D=MEL&amp;date_out%5B0%5D=2027-05-11&amp;from%5B1%5D=MEL&amp;to%5B1%5D=BER&amp;date_out%5B1%5D=2027-05-29&amp;oneway=true&amp;cabinclass=Y&amp;direct=false&amp;adults=1&amp;children=0&amp;infants=0\u00a4cy=EUR&amp;destination=trip.de\">f\u00fcr 769\u20ac<\/a><\/li>\n\n\n\n<li>Stockholm &#8211; Melbourne &#8211; Berlin <a rel=\"nofollow sponsored noopener\" href=\"https:\/\/go2.travel-dealz.de\/?type=flights&amp;from%5B0%5D=ARN&amp;to%5B0%5D=MEL&amp;date_out%5B0%5D=2027-03-02&amp;from%5B1%5D=MEL&amp;to%5B1%5D=BER&amp;date_out%5B1%5D=2027-03-22&amp;oneway=true&amp;cabinclass=Y&amp;direct=false&amp;adults=1&amp;children=0&amp;infants=0\u00a4cy=EUR&amp;destination=skyscanner\">f\u00fcr 778\u20ac<\/a><\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">Doppelte Gabelfl\u00fcge sind ebenfalls gestattet, etwa:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Zagreb &#8211; Perth | Melbourne &#8211; Berlin <a rel=\"nofollow sponsored noopener\" href=\"https:\/\/go2.travel-dealz.de\/?type=flights&amp;from%5B0%5D=ZAG&amp;to%5B0%5D=PER&amp;date_out%5B0%5D=2027-05-09&amp;from%5B1%5D=MEL&amp;to%5B1%5D=BER&amp;date_out%5B1%5D=2027-05-31&amp;oneway=true&amp;cabinclass=Y&amp;direct=false&amp;adults=1&amp;children=0&amp;infants=0\u00a4cy=EUR&amp;destination=trip.de\">f\u00fcr 725\u20ac<\/a><\/li>\n\n\n\n<li>Zagreb &#8211; Perth | Canberra &#8211; Frankfurt <a rel=\"nofollow sponsored noopener\" href=\"https:\/\/go2.travel-dealz.de\/?type=flights&amp;from%5B0%5D=ZAG&amp;to%5B0%5D=PER&amp;date_out%5B0%5D=2027-04-05&amp;from%5B1%5D=CBR&amp;to%5B1%5D=FRA&amp;date_out%5B1%5D=2027-04-22&amp;oneway=true&amp;cabinclass=Y&amp;direct=false&amp;adults=1&amp;children=0&amp;infants=0\u00a4cy=EUR&amp;destination=trip.de\">f\u00fcr 740\u20ac<\/a><\/li>\n\n\n\n<li>Warschau &#8211; Auckland | Melbourne &#8211; Frankfurt <a rel=\"nofollow sponsored noopener\" href=\"https:\/\/go2.travel-dealz.de\/?type=flights&amp;from%5B0%5D=WAW&amp;to%5B0%5D=AKL&amp;date_out%5B0%5D=2027-04-06&amp;from%5B1%5D=MEL&amp;to%5B1%5D=FRA&amp;date_out%5B1%5D=2027-04-28&amp;oneway=true&amp;cabinclass=Y&amp;direct=false&amp;adults=1&amp;children=0&amp;infants=0\u00a4cy=EUR&amp;destination=trip.de\">f\u00fcr 796\u20ac<\/a><\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">Gegen\u00fcber Hin- und R\u00fcckfl\u00fcgen ab Deutschland spart ihr je nach Strecke rund 170\u20ac bis 300\u20ac (sofern es denn unbedingt Qatar Airways sein soll).<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Verf\u00fcgbarkeiten gibt es f\u00fcr <strong>Februar bis Juni 2027<\/strong> (sowie Ende August). Verwendet zur Suche \u00fcber <a rel=\"nofollow sponsored noopener\" href=\"https:\/\/travel-dealz.de\/go\/trip-com\" data-type=\"link\" data-id=\"83769\">Trip.com<\/a> oder <a rel=\"nofollow sponsored noopener\" href=\"https:\/\/travel-dealz.de\/go\/skyscanner\" data-type=\"link\" data-id=\"80236\">Skyscanner<\/a> gerne das nachstehende Formular:<\/p>\n\n\n\t<go2-form\n\t\tclass=\"\"\n\t\tslot=\"flights\"\n\t\t\t\ttype=\"multistop\" \t\t\t\tfrom=\"WAW,AKL\" \t\t\t\tto=\"AKL,MUC,\" \t\t\t\t\t\t\t\tdate_out=\"2027-05-11,2027-05-26\" \t\t\t\t\t\t\t\tcabinclass=\"Y\" \t\t\t\tadults=\"1\" \t\t\t\t\t\t\t\t\t\t\t\tdestination=\"trip.de\" \t\t\t\tdestination_sec=\"skyscanner\" \t\t\t\tfrom_airports=\"WAW,ZAG,DUB,BCN,ARN,AKL,PER,MEL,SYD,CBR,ADL,BNE\" \t\t\t\tto_airports=\"AKL,PER,MEL,SYD,CBR,ADL,BNE,MUC,BER,ZRH,DUS\" \t\t\t\t\t\t\t\tlabel_destination=\"Suche bei Trip.com*\" \t\t\t\tlabel_destination_sec=\"Bei Skyscanner* suchen\" \t\t\t\t\t\t\t\t\t\ttarget=\"_blank\"\n\t\tdark=\"true\"\n\t\tgo2=\"https:\/\/go2.travel-dealz.de\"\n\t\tlocale=\"de\"\n\t><\/go2-form>\n\t\n\n\n<figure class=\"wp-block-image size-large\"><a rel=\"nofollow sponsored noopener\" href=\"https:\/\/go2.travel-dealz.de\/?type=flights&amp;from%5B0%5D=WAW&amp;to%5B0%5D=AKL&amp;date_out%5B0%5D=2027-05-11&amp;from%5B1%5D=AKl&amp;to%5B1%5D=MUC&amp;date_out%5B1%5D=2027-05-26&amp;oneway=true&amp;cabinclass=Y&amp;direct=false&amp;adults=1&amp;children=0&amp;infants=0%C2%A4cy=EUR&amp;destination=trip.de\"><img loading=\"lazy\" decoding=\"async\" width=\"1100\" height=\"235\" src=\"https:\/\/travel-dealz.de\/app\/uploads\/sites\/2\/wawaklmuc-1100x235.png\" alt=\"wawaklmuc\" class=\"wp-image-486630\" srcset=\"https:\/\/travel-dealz.de\/app\/uploads\/sites\/2\/wawaklmuc-1100x235.png 1100w, https:\/\/travel-dealz.de\/app\/uploads\/sites\/2\/wawaklmuc-300x64.png 300w, https:\/\/travel-dealz.de\/app\/uploads\/sites\/2\/wawaklmuc-840x180.png 840w, https:\/\/travel-dealz.de\/app\/uploads\/sites\/2\/wawaklmuc-180x38.png 180w, https:\/\/travel-dealz.de\/app\/uploads\/sites\/2\/wawaklmuc.png 1474w\" sizes=\"auto, (max-width: 1100px) 100vw, 1100px\" \/><\/a><\/figure>\n\n\n\n<blockquote class=\"wp-block-quote is-layout-flow wp-block-quote-is-layout-flow\">\n<p class=\"wp-block-paragraph\"><strong>Danke geht an Gina,<\/strong> die uns diesen Deal <a href=\"https:\/\/travel-dealz.de\/deal-melden\/\" target=\"_blank\" rel=\"noreferrer noopener\">via <em>Deal melden<\/em><\/a> gemeldet hat.<\/p>\n<\/blockquote>\n\n\n\n<div class=\"wp-block-td-gutenberg-blocks-notice is-style-info\"><div class=\"notice-block\"><div class=\"notice_title\">Einreise<\/div><div class=\"notice_content\">\n<p class=\"wp-block-paragraph\">Hinsichtlich der Einreisebestimmungen gilt f\u00fcr B\u00fcrger der D-A-CH-Staaten:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Neuseeland:<\/strong> Bis 90 Tage kein Visum, aber NzETA f\u00fcr ca. 120&nbsp;NZ$ (~60&nbsp;\u20ac) erforderlich. (<a href=\"https:\/\/www.auswaertiges-amt.de\/de\/service\/laender\/neuseeland-node\/neuseelandsicherheit-220146\" target=\"_blank\" rel=\"noopener\">Ausw. Amt<\/a> \/ <a href=\"https:\/\/en.wikipedia.org\/wiki\/Visa_policy_of_New_Zealand#Visa_policy_map\" target=\"_blank\" rel=\"noopener\">Wiki<\/a>)<\/li>\n\n\n\n<li><strong>Australien:<\/strong> kostenloses eVisitor-Visum f\u00fcr max. 90 Tage Aufenthalt (<a href=\"https:\/\/www.auswaertiges-amt.de\/de\/reiseundsicherheit\/australiensicherheit-213920\" target=\"_blank\" rel=\"noopener\">Ausw. Amt<\/a> \/ <a href=\"https:\/\/en.wikipedia.org\/wiki\/Visa_policy_of_Australia#Visa_policy_map\" target=\"_blank\" rel=\"noopener\">Wiki<\/a>)<\/li>\n<\/ul>\n<\/div><\/div><\/div>\n\n\n\n<h2 id=\"h-route-amp-bordprodukt\" class=\"wp-block-heading\">Route &amp; Bordprodukt<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Die Fl\u00fcge erfolgen in beiden Richtungen mit Zwischenstopp in Doha. Der Umstieg dauert im besten Fall rund 2 bis 5 Stunden je Richtung. Das <a href=\"https:\/\/www.auswaertiges-amt.de\/de\/reiseundsicherheit\/katarsicherheit-202280\">Ausw\u00e4rtige Amt<\/a> r\u00e4t aufgrund der volatilen Sicherheitslage weiterhin von Reisen nach Katar ab. Nach Auckland und Canberra gibt es einen zweiten Zwischenstopp in Brisbane \/ Melbourne. Vermutlich m\u00fcsst ihr das Flugzeug dann kurz verlassen.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Die Flugzeugtypen variieren je nach Strecke. Von Airbus A320 (Zagreb &#8211; Doha) bis hin zu Boeing 777 ist alles dabei. Der Sitzabstand betr\u00e4gt 79 cm. Bei einigen Fl\u00fcgen handelt es sich um Codeshares mit Virgin Australia. Auch dort stellt Qatar Airways aber Flugzeug und Besatzung, sodass der Flug kaum von einem regul\u00e4ren Qatar-Flug zu unterscheiden ist. Nur die Meilengutschrift kann darunter leiden.<\/p>\n\n\n\t<figure class=\"alignwide\">\n\t\t<flight-map\n\t\t\tid=\"flightmap-3f741766\"\n\t\t\tclass=\"flightmap not-loaded block w-full aspect-[2\/1]\"\n\t\t\tairports=\"{&quot;AKL&quot;:{&quot;iatacode&quot;:&quot;AKL&quot;,&quot;icaocode&quot;:&quot;NZAA&quot;,&quot;name&quot;:&quot;Auckland International Airport&quot;,&quot;location&quot;:&quot;Auckland&quot;,&quot;country&quot;:&quot;Neuseeland&quot;,&quot;country_code&quot;:&quot;NZ&quot;,&quot;timezone&quot;:&quot;Pacific\\\/Auckland&quot;,&quot;longitude&quot;:174.792007,&quot;latitude&quot;:-37.008099},&quot;ARN&quot;:{&quot;iatacode&quot;:&quot;ARN&quot;,&quot;icaocode&quot;:&quot;ESSA&quot;,&quot;name&quot;:&quot;Stockholm-Arlanda Airport&quot;,&quot;location&quot;:&quot;Stockholm&quot;,&quot;country&quot;:&quot;Schweden&quot;,&quot;country_code&quot;:&quot;SE&quot;,&quot;timezone&quot;:&quot;Europe\\\/Stockholm&quot;,&quot;longitude&quot;:17.9186,&quot;latitude&quot;:59.651901},&quot;BCN&quot;:{&quot;iatacode&quot;:&quot;BCN&quot;,&quot;icaocode&quot;:&quot;LEBL&quot;,&quot;name&quot;:&quot;Barcelona International Airport&quot;,&quot;location&quot;:&quot;Barcelona&quot;,&quot;country&quot;:&quot;Spanien&quot;,&quot;country_code&quot;:&quot;ES&quot;,&quot;timezone&quot;:&quot;Europe\\\/Madrid&quot;,&quot;longitude&quot;:2.07846,&quot;latitude&quot;:41.2971},&quot;BER&quot;:{&quot;iatacode&quot;:&quot;BER&quot;,&quot;icaocode&quot;:&quot;EDDB&quot;,&quot;name&quot;:&quot;Berlin Brandenburg Flughafen&quot;,&quot;location&quot;:&quot;Berlin&quot;,&quot;country&quot;:&quot;Deutschland&quot;,&quot;country_code&quot;:&quot;DE&quot;,&quot;timezone&quot;:&quot;Europe\\\/Berlin&quot;,&quot;longitude&quot;:13.509854,&quot;latitude&quot;:52.364431},&quot;BNE&quot;:{&quot;iatacode&quot;:&quot;BNE&quot;,&quot;icaocode&quot;:&quot;YBBN&quot;,&quot;name&quot;:&quot;Brisbane International Airport&quot;,&quot;location&quot;:&quot;Brisbane&quot;,&quot;country&quot;:&quot;Australien&quot;,&quot;country_code&quot;:&quot;AU&quot;,&quot;timezone&quot;:&quot;Australia\\\/Brisbane&quot;,&quot;longitude&quot;:153.117004,&quot;latitude&quot;:-27.384199},&quot;CBR&quot;:{&quot;iatacode&quot;:&quot;CBR&quot;,&quot;icaocode&quot;:&quot;YSCB&quot;,&quot;name&quot;:&quot;Canberra International Airport&quot;,&quot;location&quot;:&quot;Canberra&quot;,&quot;country&quot;:&quot;Australien&quot;,&quot;country_code&quot;:&quot;AU&quot;,&quot;timezone&quot;:&quot;Australia\\\/Canberra&quot;,&quot;longitude&quot;:149.195007,&quot;latitude&quot;:-35.3069},&quot;DOH&quot;:{&quot;iatacode&quot;:&quot;DOH&quot;,&quot;icaocode&quot;:&quot;OTHH&quot;,&quot;name&quot;:&quot;Hamad International Airport&quot;,&quot;location&quot;:&quot;Doha&quot;,&quot;country&quot;:&quot;Katar&quot;,&quot;country_code&quot;:&quot;QA&quot;,&quot;timezone&quot;:&quot;Asia\\\/Qatar&quot;,&quot;longitude&quot;:51.565056,&quot;latitude&quot;:25.261125},&quot;DUB&quot;:{&quot;iatacode&quot;:&quot;DUB&quot;,&quot;icaocode&quot;:&quot;EIDW&quot;,&quot;name&quot;:&quot;Dublin Airport&quot;,&quot;location&quot;:&quot;Dublin&quot;,&quot;country&quot;:&quot;Irland&quot;,&quot;country_code&quot;:&quot;IE&quot;,&quot;timezone&quot;:&quot;Europe\\\/Dublin&quot;,&quot;longitude&quot;:-6.27007,&quot;latitude&quot;:53.421299},&quot;DUS&quot;:{&quot;iatacode&quot;:&quot;DUS&quot;,&quot;icaocode&quot;:&quot;EDDL&quot;,&quot;name&quot;:&quot;D\\u00fcsseldorf Flughafen&quot;,&quot;location&quot;:&quot;D\\u00fcsseldorf&quot;,&quot;country&quot;:&quot;Deutschland&quot;,&quot;country_code&quot;:&quot;DE&quot;,&quot;timezone&quot;:&quot;Europe\\\/Berlin&quot;,&quot;longitude&quot;:6.76678,&quot;latitude&quot;:51.289501},&quot;FRA&quot;:{&quot;iatacode&quot;:&quot;FRA&quot;,&quot;icaocode&quot;:&quot;EDDF&quot;,&quot;name&quot;:&quot;Frankfurt am Main International Airport&quot;,&quot;location&quot;:&quot;Frankfurt&quot;,&quot;country&quot;:&quot;Deutschland&quot;,&quot;country_code&quot;:&quot;DE&quot;,&quot;timezone&quot;:&quot;Europe\\\/Berlin&quot;,&quot;longitude&quot;:8.570556,&quot;latitude&quot;:50.033333},&quot;MEL&quot;:{&quot;iatacode&quot;:&quot;MEL&quot;,&quot;icaocode&quot;:&quot;YMML&quot;,&quot;name&quot;:&quot;Melbourne International Airport&quot;,&quot;location&quot;:&quot;Melbourne&quot;,&quot;country&quot;:&quot;Australien&quot;,&quot;country_code&quot;:&quot;AU&quot;,&quot;timezone&quot;:&quot;Australia\\\/Melbourne&quot;,&quot;longitude&quot;:144.843002,&quot;latitude&quot;:-37.673302},&quot;MUC&quot;:{&quot;iatacode&quot;:&quot;MUC&quot;,&quot;icaocode&quot;:&quot;EDDM&quot;,&quot;name&quot;:&quot;M\\u00fcnchen Flughafen&quot;,&quot;location&quot;:&quot;M\\u00fcnchen&quot;,&quot;country&quot;:&quot;Deutschland&quot;,&quot;country_code&quot;:&quot;DE&quot;,&quot;timezone&quot;:&quot;Europe\\\/Berlin&quot;,&quot;longitude&quot;:11.7861,&quot;latitude&quot;:48.353802},&quot;PER&quot;:{&quot;iatacode&quot;:&quot;PER&quot;,&quot;icaocode&quot;:&quot;YPPH&quot;,&quot;name&quot;:&quot;Perth International Airport&quot;,&quot;location&quot;:&quot;Perth&quot;,&quot;country&quot;:&quot;Australien&quot;,&quot;country_code&quot;:&quot;AU&quot;,&quot;timezone&quot;:&quot;Australia\\\/Perth&quot;,&quot;longitude&quot;:115.967003,&quot;latitude&quot;:-31.9403},&quot;SYD&quot;:{&quot;iatacode&quot;:&quot;SYD&quot;,&quot;icaocode&quot;:&quot;YSSY&quot;,&quot;name&quot;:&quot;Sydney Kingsford Smith International Airport&quot;,&quot;location&quot;:&quot;Sydney&quot;,&quot;country&quot;:&quot;Australien&quot;,&quot;country_code&quot;:&quot;AU&quot;,&quot;timezone&quot;:&quot;Australia\\\/Sydney&quot;,&quot;longitude&quot;:151.177002,&quot;latitude&quot;:-33.946098},&quot;WAW&quot;:{&quot;iatacode&quot;:&quot;WAW&quot;,&quot;icaocode&quot;:&quot;EPWA&quot;,&quot;name&quot;:&quot;Warsaw Chopin Airport&quot;,&quot;location&quot;:&quot;Warsaw&quot;,&quot;country&quot;:&quot;Polen&quot;,&quot;country_code&quot;:&quot;PL&quot;,&quot;timezone&quot;:&quot;Europe\\\/Warsaw&quot;,&quot;longitude&quot;:20.9671,&quot;latitude&quot;:52.165699},&quot;ZAG&quot;:{&quot;iatacode&quot;:&quot;ZAG&quot;,&quot;icaocode&quot;:&quot;LDZA&quot;,&quot;name&quot;:&quot;Zagreb Airport&quot;,&quot;location&quot;:&quot;Zagreb&quot;,&quot;country&quot;:&quot;Kroatien&quot;,&quot;country_code&quot;:&quot;HR&quot;,&quot;timezone&quot;:&quot;Europe\\\/Zagreb&quot;,&quot;longitude&quot;:16.0688,&quot;latitude&quot;:45.742901}}\"\n\t\t\troutes=\"ZAG-DOH-WAW,DUB-DOH-BCN,ARN-DOH-MUC,BER-DOH-FRA,DUS-DOH\nCBR-MEL-DOH-SYD\nAKL-BNE-DOH\nPER-DOH\"\n\t\t\tlabels=\"iatacode\"\n\t\t\tprojection=\"mercator\"\n\t\t\tzoom=\"0\"\n\t\t\t\t\t>\n\t\t<\/flight-map>\n\t\t\t<\/figure>\n\t\n\n\n<h2 id=\"h-suchen-amp-buchen\" class=\"wp-block-heading\">Suchen &amp; Buchen<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Buchbar sind die Fl\u00fcge voraussichtlich bis 6. November 2026. Verf\u00fcgbarkeiten konnten wir f\u00fcr Abfl\u00fcge in folgenden Zeitr\u00e4umen finden (je nach Strecke ggf. abweichend):<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Februar bis Juni 2027<\/li>\n\n\n\n<li>Mitte bis Ende August 2027<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">Der <a href=\"https:\/\/travel-dealz.de\/lexikon\/mindestaufenthalt\/\">Mindestaufenthalt<\/a> betr\u00e4gt 4 Tage, maximal d\u00fcrft ihr laut Tarif 2 Monate am Reiseziel verbringen.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Die Fl\u00fcge k\u00f6nnen einmalig kostenlos (= &#8222;nur&#8220; Tarifdifferenz) umgebucht werden. Drittanbieter berechnen ggf. zus\u00e4tzliche Geb\u00fchren daf\u00fcr.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Prinzipiell lassen sich die Fl\u00fcge \u00fcber <a href=\"https:\/\/www.google.de\/travel\/flights\/?tfs=Gh4SCjIwMjctMDUtMTFqBwgBEgNXQVdyBwgBEgNBS0waHhIKMjAyNy0wNS0yNmoHCAESA0FLTHIHCAESA01VQ0ABSAE%3D&amp;curr=EUR\">Google Flights<\/a> und die ITA Matrix finden. Allerdings funktioniert der Preiskalender nicht f\u00fcr Gabelfl\u00fcge, sodass ihr ggf. etwas rumprobieren m\u00fcsst. Buchen k\u00f6nnt ihr dann direkt bei <a rel=\"nofollow sponsored noopener\" href=\"https:\/\/travel-dealz.de\/go\/qatar-airways\" data-type=\"link\" data-id=\"79397\">Qatar Airways<\/a> oder mit bis zu 30\u20ac Rabatt \u00fcber <a rel=\"nofollow sponsored noopener\" href=\"https:\/\/travel-dealz.de\/go\/trip-com\" data-type=\"link\" data-id=\"83769\">Trip.com<\/a> \/ <a rel=\"nofollow sponsored noopener\" href=\"https:\/\/travel-dealz.de\/go\/skyscanner\" data-type=\"link\" data-id=\"80236\">Skyscanner<\/a>.<\/p>\n\n\n\n<h2 id=\"h-meilen\" class=\"wp-block-heading\">Meilen<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Die Tickets werden in <a href=\"https:\/\/travel-dealz.de\/lexikon\/buchungsklassen\/\">Buchungsklasse<\/a> <a href=\"https:\/\/wheretocredit.com\/de\/QR\/O\">O<\/a> ausgestellt. F\u00fcr das Beispiel <code>WAW - DOH - AKL - DOH - MUC<\/code> habt ihr folgende M\u00f6glichkeiten zwecks Meilengutschrift:<\/p>\n\n\n<div><ul class=\"col-2\"><li>11.595 Avios + 92 Qpoints bei Qatar Privilege Club<\/li><li>9.329 Pr\u00e4mienmeilen bei Xiamen Airlines Egret Club<\/li><li>5.797 Meilen bei American AAdvantage<\/li><li>5.797 Pr\u00e4mienmeilen bei Bangkok Airways FlyerBonus<\/li><li>5.797 Pr\u00e4mienmeilen bei JetBlue TrueBlue<\/li><li>5.797 Pr\u00e4mienmeilen bei LATAM Pass<\/li><li>5.797 Meilen bei MEA Cedar Miles<\/li><li>5.797 Meilen bei Royal Air Maroc Safar Flyer<\/li><li>5.797 Meilen bei Royal Jordanian Royal Club<\/li><li>5.797 Meilen bei SriLankan FlySmiLes<\/li><li>5.797 Pr\u00e4mienmeilen bei Oman Air Sindbad<\/li><li>5.797 Punkte bei Finnair Plus<\/li><li>5.797 Meilen bei Alaska\/Hawaiian Atmos Rewards<\/li><li>5.797 Avios + 927 Tier Points bei British Airways Club<\/li><li>5.797 Avios + 900 Elite Points bei Iberia Plus<\/li><li>5.797 Points + 32 Elite Points bei Malaysia Airlines Enrich<\/li><li><a href=\"https:\/\/travel-dealz.de\/tools\/meilenrechner\/#route=QR%3AO%3AWAW-DOH-AKL-DOH-MUC\">Berechnung anpassen<\/a><\/li><\/ul><div class=\"text-right\"><small>Daten bereitgestellt von <a href=\"https:\/\/wheretocredit.com\" target=\"_blank\" rel=\"noindex noopener\">wheretocredit.com<\/a>. Ohne Garantie auf Richtigkeit.<\/small><\/div><\/div>\n\n\n<p class=\"wp-block-paragraph\">F\u00fcr Fl\u00fcge mit VA-Flugnummer gibt es bei den meisten Programmen vermutlich gar keine Meilen. Zwecks Meilengutschrift w\u00e4re es also sinnvoll, die Segmente op. by Virgin Australia zu vermeiden.<\/p>\n\n\n\n<aside class=\"wp-block-group is-layout-constrained wp-block-group-is-layout-constrained\">\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" \/>\n\n\n\n<p class=\"wp-block-paragraph\">Nicht das Passende dabei? Bleibt auf dem Laufenden mit unseren WhatsApp- und Telegram-Kan\u00e4len und abonniert unseren Newsletter:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>G\u00fcnstige Business- &amp; First Class-Fl\u00fcge: <a href=\"https:\/\/travel-dealz.de\/whatsapp\/businessfirst\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp<\/a> \/ <a href=\"https:\/\/travel-dealz.de\/telegram\/businessfirst\" target=\"_blank\" rel=\"noreferrer noopener\">Telegram<\/a><\/li>\n\n\n\n<li>Alle Kreuzfahrtangebote: <a href=\"https:\/\/travel-dealz.de\/whatsapp\/kreuzfahrten\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp<\/a> \/ <a href=\"https:\/\/travel-dealz.de\/telegram\/kreuzfahrten\" target=\"_blank\" rel=\"noreferrer noopener\">Telegram<\/a><\/li>\n\n\n\n<li>Kreuzfahrt f\u00fcr Alleinreisende: <a href=\"https:\/\/travel-dealz.de\/whatsapp\/alleinreisende\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp<\/a> \/ <a href=\"https:\/\/travel-dealz.de\/telegram\/alleinreisende\" target=\"_blank\" rel=\"noreferrer noopener\">Telegram<\/a><\/li>\n\n\n\n<li>Flusskreuzfahrten: <a href=\"https:\/\/travel-dealz.de\/whatsapp\/flusskreuzfahrten\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp<\/a> \/ <a href=\"https:\/\/travel-dealz.de\/telegram\/flusskreuzfahrten\" target=\"_blank\" rel=\"noreferrer noopener\">Telegram<\/a><\/li>\n\n\n\n<li>Luxuskreuzfahrten: <a href=\"https:\/\/travel-dealz.de\/whatsapp\/luxuskreuzfahrten\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp<\/a> \/ <a href=\"https:\/\/travel-dealz.de\/telegram\/luxuskreuzfahrten\" target=\"_blank\" rel=\"noreferrer noopener\">Telegram<\/a><\/li>\n<\/ul>\n\n\n<viewport-highlight>\n\t<a