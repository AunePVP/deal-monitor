/wp-json\/wp\/v2\/types"}],"wp:items":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/global-styles"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},"wp_navigation":{"description":"Navigationsmen\u00fcs, die in deine Website eingef\u00fcgt werden k\u00f6nnen.","hierarchical":false,"has_archive":false,"name":"Navigationsmen\u00fcs","slug":"wp_navigation","icon":null,"taxonomies":[],"rest_base":"navigation","rest_namespace":"wp\/v2","template":[],"template_lock":false,"_links":{"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/types"}],"wp:items":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/navigation"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},"wp_font_family":{"description":"","hierarchical":false,"has_archive":false,"name":"Schriftfamilien","slug":"wp_font_family","icon":null,"taxonomies":[],"rest_base":"font-families","rest_namespace":"wp\/v2","template":[],"template_lock":false,"_links":{"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/types"}],"wp:items":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/font-families"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},"wp_font_face":{"description":"","hierarchical":false,"has_archive":false,"name":"Schriftschnitte","slug":"wp_font_face","icon":null,"taxonomies":[],"rest_base":"font-families\/(?P<font_family_id>[\\d]+)\/font-faces","rest_namespace":"wp\/v2","template":[],"template_lock":false,"_links":{"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/types"}],"wp:items":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/font-families\/(?P<font_family_id>[\\d]+)\/font-faces"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},"article":{"description":"Hier geben wir euch Einblicke in verschiedene Reisetipps und stellen euch einige der beliebtesten oder exotischsten Kabinen vor. Wir zeigen euch, wie ihr das Beste aus euren Reisen, Meilen und Geld machen k\u00f6nnt, und versuchen, unser gesammeltes Wissen mit euch zu teilen.","hierarchical":false,"has_archive":true,"name":"Artikel","slug":"article","icon":"dashicons-text-page","taxonomies":["category","post_tag","airline","cruiseline","region","destinations","origins","visibility"],"rest_base":"article","rest_namespace":"wp\/v2","template":[],"template_lock":false,"_links":{"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/types"}],"wp:items":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},"news":{"description":"Die neuesten Neuigkeiten aus aller Welt. Ob es sich um das neueste Business-Class-Produkt einer Airline oder die angek\u00fcndigte Fusion zweier Hoteltreueprogramme handelt \u2013 erfahrt alles Wissenswerte \u00fcber die Themen, die die Branche bewegen.","hierarchical":false,"has_archive":true,"name":"News","slug":"news","icon":"dashicons-text-page","taxonomies":["category","post_tag","airline","cruiseline","region","destinations","visibility"],"rest_base":"news","rest_namespace":"wp\/v2","template":[],"template_lock":false,"_links":{"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/types"}],"wp:items":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/news"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},"deal":{"description":"Der Titel sagt schon alles. Hier sammeln wir die besten Reiseangebote, die wir finden k\u00f6nnen. G\u00fcnstige Fl\u00fcge in der Economy-, Business- und First Class sowie verg\u00fcnstigte Hotel\u00fcbernachtungen oder Bonuspunkte helfen euch dabei, eure Reisetr\u00e4ume zu verwirklichen. Wir empfehlen dir, t\u00e4glich hier vorbeizuschauen, denn dein n\u00e4chster Urlaub ist nur ein Reiseangebot entfernt.","hierarchical":false,"has_archive":true,"name":"Deals","slug":"deal","icon":"dashicons-megaphone","taxonomies":["category","post_tag","airline","cruiseline","region","destinations","origins","period","visibility"],"rest_base":"deal","rest_namespace":"wp\/v2","template":[],"template_lock":false,"_links":{"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/types"}],"wp:items":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},"ticker":{"description":"Nicht alle Deals, die wir finden, schaffen es auf die Startseite. Aber viele Angebote sind zu gut, um sie einfach in den digitalen Papierkorb zu werfen. Deshalb ver\u00f6ffentlichen wir hier kurze Angebote und Neuigkeiten.","hierarchical":false,"has_archive":true,"name":"Ticker","slug":"ticker","icon":"dashicons-bell","taxonomies":["category","post_tag","airline","cruiseline","region","destinations","origins","period","visibility"],"rest_base":"ticker","rest_namespace":"wp\/v2","template":[["core\/paragraph",{"placeholder":"Einleitung..."}],["core\/buttons",[],[["core\/button",{"text":"Show Deal","target":"_blank"}]]]],"template_lock":false,"_links":{"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/types"}],"wp:items":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},"coupon":{"description":"Mit Gutscheinen k\u00f6nnt ihr auf Reisen viel Geld sparen. Ganz gleich, welche Art von Reise ihr plant \u2013 eine Pauschalreise, einen Wochenendausflug in ein sch\u00f6nes Hotel oder einen Familienausflug in einen Freizeitpark\u00a0\u2013, schau immer zuerst hier vorbei. Wir zeigen euch, wie ihr mit unseren Gutscheinangeboten euer hart verdientes Geld dort behalten k\u00f6nnt, wo ihr es am liebsten habt: in eurer Tasche.","hierarchical":false,"has_archive":true,"name":"Gutscheine","slug":"coupon","icon":"dashicons-tag","taxonomies":["category","post_tag","airline","cruiseline","region","destinations","visibility"],"rest_base":"coupon","rest_namespace":"wp\/v2","template":[],"template_lock":false,"_links":{"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/types"}],"wp:items":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/coupon"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},"podcast":{"description":"Error Fares, Reiseschn\u00e4ppchen, Meilenprogramme und viele andere Themen rund um Reisen & Luftfahrt. Der Travel-Dealz Podcast ist Pflichtprogramm f\u00fcr alle Vielflieger und Meilensammler! Am 20. eines jeden Monats erscheint eine neue Folge, in der sich Adrian mit einem Experten als Gast \u00fcber ein spezielles Thema austauscht. Stay tuned und abonniert uns!","hierarchical":false,"has_archive":true,"name":"Podcasts","slug":"podcast","icon":"dashicons-microphone","taxonomies":["category","post_tag","airline","cruiseline","region","destinations","visibility"],"rest_base":"podcast","rest_namespace":"wp\/v2","template":[],"template_lock":false,"_links":{"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/types"}],"wp:items":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/podcast"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},"jp_act_log_event":{"description":"","hierarchical":false,"has_archive":false,"name":"Activity Log Events","slug":"jp_act_log_event","icon":null,"taxonomies":[],"rest_base":"activity-log-events","rest_namespace":"wp\/v2","template":[],"template_lock":false,"_links":{"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/types"}],"wp:items":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/activity-log-events"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},"ap_actor":{"description":"","hierarchical":false,"has_archive":false,"name":"Follower","slug":"ap_actor","icon":null,"taxonomies":[],"rest_base":"ap_actor","rest_namespace":"wp\/v2","template":[],"template_lock":false,"_links":{"collection":[{"href":"https:\/\/t