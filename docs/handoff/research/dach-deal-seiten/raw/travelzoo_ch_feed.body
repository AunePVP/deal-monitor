    <script>
        function headerMenuSignOut() {
            $.get("/MyAccount/logout/",
                {
                    timeStamp: Date.now()
                }).done(function (data) {
                tzoo.MemberIdLoggedIn = "";
                tzoo.layout.reloadHeader();
                $(document).trigger("signedout.headermenu");
            });
        }
            
            $(document).ready(function() {
                tzoo.layout.reloadMemberRecognition();
