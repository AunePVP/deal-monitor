s=3215"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?tags=3215"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/news?tags=3215"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?tags=3215"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?tags=3215"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/coupon?tags=3215"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/podcast?tags=3215"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/pages?tags=3215"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2180,"count":20,"description":"","link":"https:\/\/travel-dealz.de\/thema\/steigenberger-hotels\/","name":"Steigenberger Hotels","slug":"steigenberger-hotels","taxonomy":"post_tag","meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/tags\/2180","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/tags"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/post_tag"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?tags=2180"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?tags=2180"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/news?tags=2180"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?tags=2180"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?tags=2180"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/coupon?tags=2180"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/podcast?tags=2180"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/pages?tags=2180"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2606,"count":20,"description":"World of Hyatt (ehemals Gold Passport) ist das Bonusprogramm der Hotelkette Hyatt. F\u00fcr jeden ausgegebenen US-Dollar gibt es 5 Punkte gutgeschrieben, die wiederum gegen Pr\u00e4mien eingel\u00f6st werden k\u00f6nnen. Dabei gibt es keine Blackout-Daten. Es muss nur ein Standardzimmer im Hotel frei sein. Alternativ kann man die Punkte auch in Meilen umwandeln.<!--more-->\r\n<h2>Statusvorteile<\/h2>\r\nNach 10 qualifizierenden N\u00e4chten oder 25.000 Basispunkten in einem Kalenderjahr gibt es den Discoverist Status. Die Vorteile halten sich mit Premium-Internetzugang und einer Flasche Wasser pro Tag in Grenzen.\r\nNach 30 N\u00e4chten oder 50.000 Basispunkten gibt es den Explorist Status. Daf\u00fcr erh\u00e4lt man vier Mal pro Jahr Zugang zur Club Lounge inkl. t\u00e4glichen Fr\u00fchst\u00fcck.\r\n\r\nInteressanter wird es mit dem Globalist Status nach 60 N\u00e4chten oder 100.000 Basispunkten. Damit erh\u00e4lt man ein Upgrade in das beste verf\u00fcgbare Zimmer inkl. Standard Suiten und garantierten Zugang zur Club Lounge. Au\u00dferdem wird auf Resort Fee's verzichtet.","link":"https:\/\/travel-dealz.de\/thema\/gold-passport\/","name":"World of Hyatt","slug":"gold-passport","taxonomy":"post_tag","meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/tags\/2606","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/tags"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/post_tag"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?tags=2606"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?tags=2606"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/news?tags=2606"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?tags=2606"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?tags=2606"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/coupon?tags=2606"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/podcast?tags=2606"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/pages?tags=2606"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2643,"count":20,"description":"","link":"ht