							<i aria-hidden="true" class="eicon-chevron-left"></i>						</div>
						<div class="elementor-swiper-button elementor-swiper-button-next" role="button" tabindex="0" aria-label="Nächster">
							<i aria-hidden="true" class="eicon-chevron-right"></i>						</div>
																<div class="swiper-pagination"></div>
												</div>
				</div>
								</div>
				</div>
					</div>
		</div>
					</div>
		</section>
				<section class="elementor-section elementor-top-section elementor-element elementor-element-c6e2f03 elementor-section-boxed elementor-section-height-default elementor-section-height-default" data-id="c6e2f03" data-element_type="section">
						<div class="elementor-container elementor-column-gap-default">
					<div class="elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-4a1dc0d" data-id="4a1dc0d" data-element_type="column">
			<div class="elementor-widget-wrap elementor-element-populated">
						<div class="elementor-element elementor-element-014edcb elementor-post-navigation-borders-yes elementor-widget elementor-widget-post-navigation" data-id="014edcb" data-element_type="widget" data-widget_type="post-navigation.default">
				<div class="elementor-widget-container">
							<div class="elementor-post-navigation" role="navigation" aria-label="Beitrag Navigation">
			<div class="elementor-post-navigation__prev elementor-post-navigation__link">
