[{"id":2940,"count":967,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/frankfurt-fra\/","name":"Frankfurt\/Main [FRA]","slug":"frankfurt-fra","taxonomy":"origins","parent":2979,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2940","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2979"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2940"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2940"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2940"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2940"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2941,"count":764,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/muenchen-muc\/","name":"M\u00fcnchen [MUC]","slug":"muenchen-muc","taxonomy":"origins","parent":2982,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2941","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2982"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2941"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2941"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2941"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2941"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2945,"count":658,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/hamburg-ham\/","name":"Hamburg [HAM]","slug":"hamburg-ham","taxonomy":"origins","parent":2980,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2945","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2980"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2945"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2945"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2945"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2945"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2939,"count":625,"description":"Der internationale Flughafen D\u00fcsseldorf ist nach Frankfurt\/Main und M\u00fcnchen der drittgr\u00f6\u00dfte Flughafen Deutschlands. J\u00e4hrlich nutzen rund 25 Millionen Passagiere den Flughafen in Westdeutschland.\r\n\r\nDer Flughafen ist ein wichtiges Drehkreuz f\u00fcr die Fluggesellschaft Eurowings. Diese fliegt ab D\u00fcsseldorf viele Ziele in Deutschland und Europa an.\r\n\r\nZus\u00e4tzlich fliegen Delta Air Lines nach Atlanta, Etihad nach Abu Dhabi, Emirates nach Dubai, Air China nach Peking, Singapore Airlines nach Singapur und ANA nach Tokio.\r\n\r\nF\u00fcr die Anreise verf\u00fcgt der Flughafen neben zahlreichen Parkpl\u00e4tzen auch zwei Bahnh\u00f6fe. Einen direkt im Terminal <em>D\u00fcsseldorf Flughafen Terminal<\/em> der von der S-Bahn S11 (Bergisch Gladbach - ... - K\u00f6ln-Hauptbahnhof - ... - Neuss-Hauptbahnhof ...\u00a0 - D\u00fcsseldorf-Hauptbahnhof - ... - D\u00fcsseldorf-Flughafen-Terminal)\u00a0 angefahren wird und der Fernbahnhof <em>Bahnhof D\u00fcsseldorf Flughafen<\/em>, wo u.a. Fernz\u00fcge ICE\/IC und Regionalexpress RE halten.\r\nDer Fernbahnhof ist \u00fcber einen SkyTrain an den Flughafen angebunden. Dieser ist f\u00fcr Flugg\u00e4ste kostenfrei nutzbar.","link":"https:\/\/travel-dealz.de\/abflug\/duesseldorf-dus\/","name":"D\u00fcsseldorf [DUS]","slug":"duesseldorf-dus","taxonomy":"origins","parent":2979,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2939","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2979"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2939"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2939"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2939"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2939"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2942,"count":508,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/berlin-ber\/","name":"Berlin [BER]","slug":"berlin-ber","taxonomy":"origins","parent":2981,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2942","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2981"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2942"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2942"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2942"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2942"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2965,"count":398,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/wien-vie\/","name":"Wien [VIE]","slug":"wien-vie","taxonomy":"origins","parent":2964,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2965","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2964"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2965"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2965"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2965"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2965"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2946,"count":348,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/stuttgart-str\/","name":"Stuttgart [STR,ZWS]","slug":"stuttgart-str","taxonomy":"origins","parent":2982,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2946","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2982"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2946"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2946"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2946"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2946"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2971,"count":336,"description":"Der Flughafen Z\u00fcrich fungiert als Drehkreuz f\u00fcr Swiss, Edelweiss und Helvetic Airways. Er ist der mit Abstand gr\u00f6\u00dfte Schweizer Flughafen und fertige im Jahr 2019 mehr als 30 Millionen Passagiere ab. F\u00fcr Aviation Geeks gibt es \u00fcbrigens eine nette Aussichtsterrasse mit direkter Sicht auf das Vorfeld. ;)\r\n\r\nVon Z\u00fcrich bis zur Grenze nach Deutschland sind es nur rund 50 km. Aus S\u00fcdwestdeutschland ist Z\u00fcrich mit der Deutschen Bahn und SBB gut erreichbar. Mit dem <a href=\"https:\/\/www.awin1.com\/cread.php?awinmid=14964&amp;awinaffid=135115&amp;p=https%3A%2F%2Fwww.bahn.de%2Fp%2Fview%2Fangebot%2Fsparpreis-europa%2Fschweiz.shtml\" target=\"_blank\" rel=\"noopener noreferrer nofollow sponsored\">Sparpreis der DB<\/a> k\u00f6nnt ihr z.B. ab Stuttgart oder Freiburg bereits f\u00fcr 18,90\u20ac zum Flughafen Z\u00fcrich fahren. Ab \u00d6sterreich lohnt sich ein Blick auf die <a href=\"https:\/\/www.oebb.at\/de\/tickets-kundenkarten\/oesterreich-europa\/sparschiene\/sparschiene-europa\/schweiz\" target=\"_blank\" rel=\"noopener\">Sparschiene Schweiz<\/a> der \u00d6BB.\r\n\r\nDie Anreise mit dem Flugzeug ist nat\u00fcrlich ebenfalls m\u00f6glich, aber teurer. Ab Deutschland gibt es Verbindungen <a href=\"https:\/\/travel-dealz.de\/go\/swiss\" target=\"_blank\" rel=\"noopener noreferrer nofollow sponsored\">Swiss<\/a>, <a href=\"https:\/\/travel-dealz.de\/go\/lufthansa\" target=\"_blank\" rel=\"noopener noreferrer nofollow sponsored\">Lufthansa,<\/a> <a href=\"https:\/\/travel-dealz.de\/go\/Eurowings\" target=\"_blank\" rel=\"noopener noreferrer nofollow sponsored\">Eurowings<\/a> und <a href=\"https:\/\/travel-dealz.de\/go\/easyjet\" target=\"_blank\" rel=\"noopener nofollow sponsored\">Easyjet<\/a>. Eine stets aktuelle \u00dcbersicht aller Flugverbindungen findet ihr in der <a href=\"https:\/\/en.wikipedia.org\/wiki\/Zurich_Airport#Airlines_and_destinations\" target=\"_blank\" rel=\"noopener\">englischsprachigen Wikipedia<\/a> oder bei <a href=\"https:\/\/www.flightradar24.com\/data\/airports\/zrh\/routes\" target=\"_blank\" rel=\"noopener\">Flightradar24<\/a>. Konkrete Fl\u00fcge und Preise gibt es z.B. \u00fcber unsere <a href=\"https:\/\/travel-dealz.de\/flugsuche\/\" target=\"_blank\" rel=\"noopener\">Flugsuche<\/a>.","link":"https:\/\/travel-dealz.de\/abflug\/zuerich-zrh\/","name":"Z\u00fcrich [ZRH]","slug":"zuerich-zrh","taxonomy":"origins","parent":2970,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2971","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2970"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2971"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2971"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2971"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2971"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2938,"count":276,"description":"Der Flughafen K\u00f6ln\/Bonn liegt in Westdeutschland bei K\u00f6ln. Zum Einzugsgebiet geh\u00f6ren aber auch Bonn, D\u00fcsseldorf und das Ruhrgebiet. J\u00e4hrlich nutzen mehr als 10 Millionen Passagiere den Flughafen.\r\n\r\nDer Flughafen ist vor allem als Basis f\u00fcr mehrere Billigflieger bekannt. Er ist Heimatbasis von <a href=\"https:\/\/travel-dealz.de\/thema\/eurowings\/\" target=\"_blank\" rel=\"noopener\">Eurowings<\/a>. Gleiches gilt f\u00fcr <a href=\"https:\/\/travel-dealz.de\/thema\/ryanair\/\">Ryanair<\/a>, die von der Basis in K\u00f6ln\/Bonn aus Kurz- und Mittelstrecken durchf\u00fchren.\r\n\r\nAb <strong>K\u00f6ln Hbf<\/strong> ist der Flughafen mit dem Regionalexpress oder der S-Bahn innerhalb von 15 Minuten zu erreichen. Zus\u00e4tzlich f\u00e4hrt ab Porz die Buslinie 161 zum Flughafen. Ab <strong>Bonn Hbf<\/strong> f\u00e4hrt die Schnellbuslinie SB60 zum Flughafen.\r\nAu\u00dferdem verf\u00fcgt der Flughafen \u00fcber ein <strong>ICE- und Fernbusbahnhof<\/strong>. Mit dem ICE ist der Flughafen K\u00f6ln\/Bonn z.B. vom Frankfurter Flughafen aus in rund 1 Stunde und 10 Minuten Fahrzeit erreichbar.","link":"https:\/\/travel-dealz.de\/abflug\/koeln-bonn-cgn\/","name":"K\u00f6ln\/Bonn [CGN]","slug":"koeln-bonn-cgn","taxonomy":"origins","parent":2979,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2938","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2979"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2938"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2938"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2938"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2938"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2961,"count":267,"description":"Der internationale Flughafen Amsterdam Schiphol ist eines der gr\u00f6\u00dften Drehkreuze Europas und Heimatbasis von KLM. Angeboten werden Direktverbindungen in jede Ecke Europas, aber auch unz\u00e4hlige Langstrecken nach Nord- und S\u00fcdamerika, Afrika, in den Nahen Osten und nach Asien.\r\n\r\nAmsterdam ist besonders von Westdeutschland aus recht gut mit dem Auto zu erreichen. Die Fahrt von K\u00f6ln dauert beispielsweise um die 3 Stunden.\r\n\r\nAuch mit der Deutschen Bahn seid ihr nicht viel l\u00e4nger unterwegs. Mit dem <a href=\"https:\/\/www.awin1.com\/cread.php?awinmid=14964&amp;awinaffid=135115&amp;p=https%3A%2F%2Fwww.bahn.de%2Fp%2Fview%2Fangebot%2Fsparpreis-europa%2Fniederlande.shtml\" target=\"_blank\" rel=\"noopener nofollow sponsored\">Sparpreis Niederlande<\/a> k\u00f6nnt ihr ab 18,90\u20ac nach Amsterdam reisen. Bucht das Ticket am besten direkt <em>bis Schiphol (Airport)<\/em>, dann spart ihr euch eine separate Fahrkarte zum Flughafen. Alternativ kommt ihr auch mit dem <a href=\"https:\/\/travel-dealz.de\/go\/flixbus\" target=\"_blank\" rel=\"noopener noreferrer nofollow sponsored\">Flixbus<\/a> preiswert nach Amsterdam.\r\n\r\nFalls euch die Anreise mit Bahn oder Auto zu lange dauert, k\u00f6nnt ihr nat\u00fcrlich auch einen Zubringerflug buchen. Alleine KLM fliegt zehn deutsche Flugh\u00e4fen an, dazu kommen verschiedene Optionen mit z.B. Lufthansa, Swiss, Eurowings oder Easyjet. Eine \u00dcbersicht aller Flugverbindungen nach Amsterdam findet ihr in der <a href=\"https:\/\/en.wikipedia.org\/wiki\/Amsterdam_Airport_Schiphol#Airlines_and_destinations\" target=\"_blank\" rel=\"noopener\">englischsprachigen Wikipedia<\/a> oder bei <a href=\"https:\/\/www.flightradar24.com\/data\/airports\/ams\/routes\" target=\"_blank\" rel=\"noopener\">Flightradar24<\/a>. Buchen k\u00f6nnt ihr die Fl\u00fcge dann z.B. \u00fcber die <a href=\"https:\/\/travel-dealz.de\/flugsuche\/\" target=\"_blank\" rel=\"noopener\">Travel-Dealz-Flugsuche<\/a>.","link":"https:\/\/travel-dealz.de\/abflug\/amsterdam-schiphol-ams\/","name":"Amsterdam [AMS]","slug":"amsterdam-schiphol-ams","taxonomy":"origins","parent":2960,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2961","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2960"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2961"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2961"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2961"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2961"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2957,"count":264,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/hannover-haj\/","name":"Hannover [HAJ]","slug":"hannover-haj","taxonomy":"origins","parent":2980,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2957","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2980"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2957"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2957"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2957"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2957"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2947,"count":215,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/nuernberg-nue\/","name":"N\u00fcrnberg [NUE]","slug":"nuernberg-nue","taxonomy":"origins","parent":2982,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2947","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2982"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2947"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2947"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2947"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2947"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2972,"count":160,"description":"Der <i>EuroAirport Basel Mulhouse Freiburg<\/i> liegt zwar auf franz\u00f6sischen Staatsgebiet, genie\u00dft aber einen binationalen Status. Er wird von Frankreich und der Schweiz gemeinsam betrieben und besitzt daher auch zwei Ausg\u00e4nge: Einen f\u00fcr Frankreich und einen f\u00fcr die Schweiz.\r\n\r\nDank der Lage im Dreil\u00e4ndereck ist der Flughafen auch von S\u00fcdwestdeutschland aus sehr einfach zu erreichen. Vom namensgebenden\u00a0 Freiburg betr\u00e4gt die Fahrzeit mit dem Auto unter eine Stunde. Auch die Anreise mit der Bahn ist eine gute Option, ab Freiburg und Z\u00fcrich dauert die Fahrt zum EuroAirport eine gute Stunde. Tickets gibt es bei der <a href=\"https:\/\/travel-dealz.de\/go\/bahn\" target=\"_blank\" rel=\"noopener nofollow sponsored\">Deutschen Bahn<\/a> (ab \/ nach Deutschland) bzw. den <a href=\"https:\/\/www.sbb.ch\/\" target=\"_blank\" rel=\"noopener\">SBB<\/a> (ab \/ in die Schweiz).\r\n\r\nDer Flughafen verf\u00fcgt \u00fcber keine direkte Schienenanbindung. Vom Bahnhof Basel SBB gibt es aber einen Bus, der euch in ca. 15 Minuten zum Flughafen bringt. In Spitzenzeiten f\u00e4hrt dieser bis 10 Mal pro Stunde. Am besten bucht ihr direkt ein durchgehendes Ticket bis zum Flughafen, dann ist der Flughafenbus bereits inklusive.\r\n\r\nDie Anreise mit dem Flugzeug ist nat\u00fcrlich ebenfalls eine Option, allerdings lohnt sich das nur bei sehr guten Angeboten. Eine \u00dcbersicht aller Flugverbindungen findet ihr in der <a href=\"https:\/\/en.wikipedia.org\/wiki\/EuroAirport_Basel_Mulhouse_Freiburg#Airlines_and_destinations\" target=\"_blank\" rel=\"noopener\">englischsprachigen Wikipedia<\/a> oder bei <a href=\"https:\/\/www.flightradar24.com\/data\/airports\/bsl\" target=\"_blank\" rel=\"noopener\">Flightradar24<\/a>, buchen k\u00f6nnt ihr z.B. \u00fcber die <a href=\"https:\/\/travel-dealz.de\/flugsuche\/\" target=\"_blank\" rel=\"noopener\">Travel-Dealz-Flugsuche<\/a>.","link":"https:\/\/travel-dealz.de\/abflug\/basel-bsl\/","name":"Basel [BSL,MLH,EAP]","slug":"basel-bsl","taxonomy":"origins","parent":2970,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2972","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2970"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2972"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2972"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2972"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2972"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":3174,"count":159,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/barcelona-bcn\/","name":"Barcelona [BCN]","slug":"barcelona-bcn","taxonomy":"origins","parent":3144,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/3174","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/3144"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=3174"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=3174"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=3174"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=3174"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2973,"count":144,"description":"Der Flughafen Genf ist der zweitgr\u00f6\u00dfte Flughafen der Schweiz und liegt im S\u00fcdwesten des Landes direkt an der franz\u00f6sischen Grenze. Er wird von beinahe jeder europ\u00e4ischen Fluggesellschaft angeflogen, die etwas auf sich h\u00e4lt.\r\n\r\nBesonders gro\u00df ist das Angebot von Swiss und Easyjet, die in Genf eine Basis unterhalten. Das Langstreckenangebot ist hingegen \u00fcberschaubar, es gibt nur einzelne Verbindungen nach Nordamerika, Afrika, Asien und in den Nahen Osten.\r\n\r\nInsbesondere von der Schweiz, aber auch ab Deutschland bietet sich nach Genf die Anreise mit der Bahn an. Mit dem <a href=\"https:\/\/www.awin1.com\/cread.php?awinmid=14964&amp;awinaffid=135115&amp;p=https%3A%2F%2Fwww.bahn.de%2Freisen%2Fview%2Fverbindung%2Fgenf.shtml\" target=\"_blank\" rel=\"noopener nofollow sponsored\">Sparpreis Genf<\/a> der Deutschen Bahn k\u00f6nnt ihr ab 27,90\u20ac von z.B. Karlsruhe, M\u00fcnchen oder Berlin nach Genf reisen.\r\n\r\nFl\u00fcge von Deutschland nach Genf gibt es mit Easyjet, Swiss, Lufthansa und Eurowings. Starten k\u00f6nnt ihr je nach Airline in Hamburg, Berlin, D\u00fcsseldorf, Frankfurt oder M\u00fcnchen. Au\u00dferdem fliegt Austrian nach Wien. Eine \u00dcbersicht aller Verbindungen von und nach Genf gibt es in der <a href=\"https:\/\/en.wikipedia.org\/wiki\/Geneva_Airport#Airlines_and_destinations\" target=\"_blank\" rel=\"noopener\">englischsprachigen Wikipedia<\/a> oder bei <a href=\"https:\/\/www.flightradar24.com\/data\/airports\/gva\/routes\" target=\"_blank\" rel=\"noopener\">Flightradar24<\/a>. Buchen k\u00f6nnt ihr dann z.B. \u00fcber unsere <a href=\"https:\/\/travel-dealz.de\/flugsuche\/\" target=\"_blank\" rel=\"noopener\">Flugsuche<\/a>.\r\n\r\n&nbsp;","link":"https:\/\/travel-dealz.de\/abflug\/genf-gva\/","name":"Genf [GVA]","slug":"genf-gva","taxonomy":"origins","parent":2970,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2973","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2970"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2973"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2973"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2973"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2973"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2988,"count":106,"description":"Paris Charles-de-Gaulle ist der zweitgr\u00f6\u00dfte Flughafen Europas und Drehkreuz von Air France. Die SkyTeam-Airline sowie viele weitere Fluggesellschaften bieten Verbindungen zu unz\u00e4hligen Flugh\u00e4fen in Europa, Nord- und S\u00fcdamerika, den Nahen Osten, Afrika und Asien an.\r\n\r\nDie Anreise nach Paris ist vor allem von Westdeutschland bequem mit dem Zug m\u00f6glich. Mit dem <a href=\"https:\/\/www.eurostar.com\/de-de\">Eurostar<\/a> (fr\u00fcher Thalys) geht es z.B. ab 32\u20ac oneway von K\u00f6ln nach Paris (Fahrtzeit 3h 30min). Die <a href=\"https:\/\/travel-dealz.de\/go\/Bahn\" target=\"_blank\" rel=\"noopener noreferrer nofollow sponsored\">Deutsche Bahn<\/a> bietet mit dem <a href=\"https:\/\/www.awin1.com\/cread.php?awinmid=14964&amp;awinaffid=135115&amp;p=https%3A%2F%2Fwww.bahn.de%2Fp%2Fview%2Fangebot%2Fsparpreis-europa%2Ffrankreich.shtml\" target=\"_blank\" rel=\"noopener nofollow sponsored\">Super Sparpreis Frankreich<\/a> Fahrten von Deutschland ab 39,90\u20ac an.\u00a0 Wer grenznah wohnt, kann den Billig-TGV <a href=\"https:\/\/www.ouigo.com\/en\/\">OuiGo<\/a> in Erw\u00e4gung ziehen. Tickets von Stra\u00dfburg gibt es dort ab 16\u20ac (Handgep\u00e4ck) bzw. 21\u20ac mit Gep\u00e4ck.\r\n\r\nF\u00fcr die Fahrt von Paris zum Flughafen m\u00fcsst ihr dann jeweils nochmal etwa 10\u20ac je Richtung einplanen.\r\n\r\nAuch per Flugzeug gibt es unz\u00e4hlige Verbindungen zum Flughafen Charles-de-Gaulle. Alleine Air France fliegt \u00fcber 10 Ziele im D-A-CH-Raum an, dazu kommen weitere Fluggesellschaften wie Lufthansa, Easyjet und Eurowings.\r\n\r\nEine stets aktuelle \u00dcbersicht aller Verbindungen nach Charles-de-Gaulle erhaltet ihr in der <a href=\"https:\/\/en.wikipedia.org\/wiki\/Charles_de_Gaulle_Airport#Passenger\" target=\"_blank\" rel=\"noopener\">englischsprachigen Wikipedia<\/a> oder (deutlich \u00fcbersichtlicher) bei <a href=\"https:\/\/www.flightradar24.com\/data\/airports\/cdg\/routes\" target=\"_blank\" rel=\"noopener\">Flightradar24<\/a>. Die Preise und Verf\u00fcgbarkeiten k\u00f6nnt ihr dann bei <a href=\"https:\/\/www.google.de\/travel\/flights\">Google Flights<\/a> oder <a href=\"https:\/\/www.kayak.de\/flights\">Kayak<\/a> checken.","link":"https:\/\/travel-dealz.de\/abflug\/paris-cdg\/","name":"Paris-Charles-de-Gaulle [CDG]","slug":"paris-cdg","taxonomy":"origins","parent":2987,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2988","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2987"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2988"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2988"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2988"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2988"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2995,"count":106,"description":"Der Flughafen Kopenhagen-Kastrup (CPH) geh\u00f6rt zu den gr\u00f6\u00dften Flughafen Skandinaviens. Entsprechend bieten SAS, Lufthansa und Co auch Linienfl\u00fcge zu einigen St\u00e4dten im D-A-CH-Raum an.\r\n\r\nEine \u00dcbersicht aller Flugverbindungen von und nach Kopenhagen erhaltet ihr auf <a href=\"https:\/\/www.flightconnections.com\/flights-from-copenhagen-cph\" target=\"_blank\" rel=\"noopener\">FlightConnections.com<\/a> oder in der <a href=\"https:\/\/en.wikipedia.org\/wiki\/Copenhagen_Airport#Passenger\" target=\"_blank\" rel=\"noopener\">englischsprachigen Wikipedia<\/a>. Buchen k\u00f6nnt ihr die Fl\u00fcge beispielsweise \u00fcber die <a href=\"https:\/\/travel-dealz.de\/flugsuche\/\" target=\"_blank\" rel=\"noopener\">Travel-Dealz-Flugsuche<\/a>.\r\n\r\nEs muss aber nicht immer das Flugzeug sein. Zumindest aus Norddeutschland kommt ihr auch mit der Bahn g\u00fcnstig nach Kopenhagen. Ab 28,90\u20ac je Richtung gibt es den <a href=\"https:\/\/www.awin1.com\/cread.php?awinmid=14964&amp;awinaffid=135115&amp;p=https%3A%2F%2Fwww.bahn.de%2Fp%2Fview%2Fangebot%2Fsparpreis-europa%2Fdaenemark.shtml\" target=\"_blank\" rel=\"noopener nofollow sponsored\">Super Sparpreis D\u00e4nemark<\/a> der Deutschen Bahn. L\u00e4ngere Strecken sind ab 37,90\u20ac erh\u00e4ltlich. Fahrtzeit: Knapp 5 Stunden von Hamburg, 3 Stunden ab Flensburg.\r\n\r\nAb MV ist auch die F\u00e4hre eine Option. Von Rostock aus k\u00f6nnt ihr mit der Scandlines-F\u00e4hre, Bus und Zug in rund 6 Stunden \u00fcber Gedser und Nykobing nach Kopenhagen gelangen. Alternativ k\u00f6nnt ihr die F\u00e4hrverbindung Rostock - Trelleborg nutzen und dann mit dem Zug \u00fcber die \u00d6resundbr\u00fccke nach Kopenhagen fahren.","link":"https:\/\/travel-dealz.de\/abflug\/kopenhagen-cph\/","name":"Kopenhagen [CPH]","slug":"kopenhagen-cph","taxonomy":"origins","parent":2994,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2995","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2994"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2995"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2995"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2995"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2995"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2959,"count":104,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/bremen-bre\/","name":"Bremen [BRE]","slug":"bremen-bre","taxonomy":"origins","parent":2980,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2959","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2980"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2959"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2959"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2959"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2959"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":3275,"count":104,"description":"Budapest ist sehr gut an die meisten Flugh\u00e4fen Europas angebunden. Ab dem D-A-CH-Raum gibt es verschiedene Verbindungen von Wizzair, Eurowings, Ryanair, Easyjet, Lufthansa, Swiss und Austrian.\r\n\r\nAm besten pr\u00fcft ihr \u00fcber <a href=\"https:\/\/www.flightconnections.com\/flights-from-budapest-bud\" target=\"_blank\" rel=\"noopener\">FlightConnections.com<\/a> oder in der <a href=\"https:\/\/en.wikipedia.org\/wiki\/Budapest_Ferenc_Liszt_International_Airport#Passenger\" target=\"_blank\" rel=\"noopener\">englischsprachigen Wikipedia<\/a>, welche Verbindungen \u00fcberhaupt verf\u00fcgbar sind. Buchen k\u00f6nnt ihr dann direkt bei der jeweiligen Airline bzw. \u00fcber die <a href=\"https:\/\/travel-dealz.de\/flugsuche\/\" target=\"_blank\" rel=\"noopener\">Travel-Dealz-Flugsuche<\/a>.\r\n\r\n<strong>Tipp<\/strong>: Falls die Direktfl\u00fcge nach Budapest zu teuer sind, k\u00f6nnt ihr alternativ auch nach Wien oder Bratislava fliegen und von dort aus mit Zug oder Fernbus nach Budapest reisen.\r\n\r\nBudapest ist auch sehr gut an das europ\u00e4ische Bahnnetz angeschlossen. Ihr habt die folgenden Optionen:\r\n<ul>\r\n \t<li>Von \u00d6sterreich kommt ihr mit dem Railjet der \u00d6BB oder den EuroCitys ab 19,90\u20ac je Richtung nach Budapest. Ab Wien dauert die Fahrt nur etwa 2h 30min. Tickets gibt es bei den <a href=\"https:\/\/tickets.oebb.at\/\" target=\"_blank\" rel=\"noopener\">\u00d6BB<\/a>.<\/li>\r\n \t<li>Ab M\u00fcnchen fahren t\u00e4glich mehrere Railjets direkt nach Budapest. Ab anderen deutschen St\u00e4dten k\u00f6nnt ihr mit Umstieg reisen. Die Fahrtzeit betr\u00e4gt rund 7h, Tickets gibt es bei der <a href=\"https:\/\/travel-dealz.de\/go\/bahn\" target=\"_blank\" rel=\"noopener nofollow sponsored\">DB<\/a> oder den <a href=\"https:\/\/tickets.oebb.at\/de\/ticket\/timetable\" target=\"_blank\" rel=\"noopener\">\u00d6BB<\/a> ab 48\u20ac je Richtung, bei der <a href=\"https:\/\/www.mavcsoport.hu\/de\" target=\"_blank\" rel=\"noopener\">ungarischen Bahn<\/a> etwas g\u00fcnstiger.<\/li>\r\n \t<li>Ebenfalls ab M\u00fcnchen verkehrt ein Nachtzug direkt nach Budapest. Diesen k\u00f6nnt ihr einfach bei der <a href=\"https:\/\/tickets.oebb.at\/\" target=\"_blank\" rel=\"noopener\">\u00d6BB<\/a> buchen.<\/li>\r\n<\/ul>\r\n<a href=\"https:\/\/travel-dealz.de\/go\/flixbus\" target=\"_blank\" rel=\"noopener nofollow sponsored\">Flixbus<\/a> bietet ebenfalls Fahrten nach Budapest an. Ab Wien k\u00f6nnt ihr sogar direkt bis zum Flughafen Budapest fahren.\r\n\r\n<strong>Tipp<\/strong>: Die ungarische Eisenbahngesellschaft M\u00c1V verf\u00fcgt in der Regel \u00fcber ein gr\u00f6\u00dferes und g\u00fcnstigeres Kontingent an Sparpreistickets - findet ihr also bei der DB oder der \u00d6BB keine besonders g\u00fcnstigen Tickets mehr, lohnt sich ein Blick auf die <a href=\"https:\/\/www.mavcsoport.hu\/de\" target=\"_blank\" rel=\"noopener\">Webseite der M\u00c1V<\/a>.","link":"https:\/\/travel-dealz.de\/abflug\/budapest-bud\/","name":"Budapest [BUD]","slug":"budapest-bud","taxonomy":"origins","parent":3273,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/3275","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/3273"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=3275"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=3275"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=3275"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=3275"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2948,"count":100,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/leipzig-halle-lej\/","name":"Leipzig [LEJ]","slug":"leipzig-halle-lej","taxonomy":"origins","parent":2981,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2948","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2981"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2948"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2948"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2948"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2948"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2963,"count":100,"description":"Der Flughafen Br\u00fcssel-Zavantem ist der gr\u00f6\u00dfte Belgiens. J\u00e4hrlich nutzen mehr als 25 Millionen Passagiere den Flughafen, der das Drehkreuz von Brussels Airlines und TUI fly Belgium darstellt. Angeflogen werden viele Ziele in Europa und Afrika, au\u00dferdem gibt es Langstrecken nach Amerika, Asien und den Nahen Osten.\r\n\r\nVor allem aus Westdeutschland kommt man sehr g\u00fcnstig nach Br\u00fcssel. Mit dem <a href=\"https:\/\/travel-dealz.de\/go\/flixbus\" target=\"_blank\" rel=\"noopener noreferrer nofollow sponsored\">Flixbus<\/a> gibt es Tickets f\u00fcr die gut dreist\u00fcndige Fahrt nach Br\u00fcssel schon f\u00fcr etwa 10\u20ac. Die Ticketpreise der <a href=\"https:\/\/travel-dealz.de\/go\/Bahn\" target=\"_blank\" rel=\"noopener noreferrer nofollow sponsored\">Bahn<\/a> beginnen bei 19,90\u20ac f\u00fcr den <a href=\"https:\/\/www.awin1.com\/cread.php?awinmid=14964&amp;awinaffid=135115&amp;p=https%3A%2F%2Fwww.bahn.de%2Fp%2Fview%2Fangebot%2Fsparpreis-europa%2Fbelgien.shtml\" target=\"_blank\" rel=\"noopener nofollow sponsored\">Super Sparpreis Belgien<\/a>. Auch Fahrten mit dem Thalys sind eine gute Option und ab und an besonders g\u00fcnstig verf\u00fcgbar.\r\n\r\nDie Anreise mit dem Flugzeug lohnt sich nur bei besonders guten Angeboten. Vom D-A-CH-Raum gibt es jede Menge Verbindungen mit Brussels Airlines und auch viele andere Airlines fliegen nach Br\u00fcssel. Eine \u00dcbersicht aller Verbindungen erhaltet ihr in der <a href=\"https:\/\/en.wikipedia.org\/wiki\/Brussels_Airport#Airlines_and_destinations\" target=\"_blank\" rel=\"noopener\">englischsprachigen Wikipedia<\/a>. Buchen k\u00f6nnt ihr sie einfach \u00fcber die <a href=\"https:\/\/travel-dealz.de\/flugsuche\/\" target=\"_blank\" rel=\"noopener\">Travel-Dealz-Flugsuche<\/a>.","link":"https:\/\/travel-dealz.de\/abflug\/brussels-bru\/","name":"Br\u00fcssel [BRU]","slug":"brussels-bru","taxonomy":"origins","parent":2962,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2963","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2962"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2963"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2963"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2963"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2963"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":3058,"count":95,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/rom-fco\/","name":"Rom [FCO]","slug":"rom-fco","taxonomy":"origins","parent":2996,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/3058","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2996"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=3058"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=3058"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=3058"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=3058"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2985,"count":86,"description":"Mit fast 4 Millionen Reisenden pro Jahr ist der Flughafen Luxemburg nach Passagierzahlen der f\u00fcnftgr\u00f6\u00dfte der Benelux-Region. Zumindest ein kleiner Teil davon geht sicher auf die unz\u00e4hligen Flugschn\u00e4ppchen zur\u00fcck, f\u00fcr die Luxemburg regelm\u00e4\u00dfig ein sehr guter Anlaufpunkt ist. Eine noch gr\u00f6\u00dfere Bedeutung hat er im Frachtflugbereich.\r\n\r\nPassagierfl\u00fcge nach Afrika und vor allem Europa werden vor allem von der Airline Luxair angeboten, welche ihr Drehkeuz am Flughafen unterh\u00e4lt. Aber auch andere Airlines wie Swiss, Lufthansa oder British Airways bieten Fl\u00fcge von und nach Luxemburg an. Eine stets aktuelle \u00dcbersicht aller Verbindungen findet ihr bei <a href=\"https:\/\/www.flightradar24.com\/data\/airports\/lux\/routes\" target=\"_blank\" rel=\"noopener\">Flightradar 24<\/a> oder der <a href=\"https:\/\/en.wikipedia.org\/wiki\/Luxembourg_Airport\" target=\"_blank\" rel=\"noopener\">englischsprachigen Wikipedia<\/a>. Buchen k\u00f6nnt ihr die Fl\u00fcge dann z.B. in der <a href=\"https:\/\/travel-dealz.de\/flugsuche\/\" target=\"_blank\" rel=\"noopener\">Travel-Dealz-Flugsuche<\/a>.\r\n\r\nBevor ihr passende Zubringerfl\u00fcge bucht, w\u00fcrden wir euch aber erstmal empfehlen, einen Blick auf die Verbindungen der Deutschen Bahn zu werfen. Von vielen St\u00e4dten in Westdeutschland k\u00f6nnt ihr mit dem <a href=\"https:\/\/www.awin1.com\/cread.php?awinmid=14964&amp;awinaffid=135115&amp;p=https%3A%2F%2Fwww.bahn.de%2Fp%2Fview%2Fangebot%2Fsparpreis-europa%2Fluxemburg.shtml\" target=\"_blank\" rel=\"noopener nofollow sponsored\">Sparpreis Luxemburg<\/a> schon ab 18,90\u20ac nach Luxemburg reisen. Auf l\u00e4ngeren Strecken wie bspw. von Hamburg gibt es Tickets ab 24,90\u20ac.","link":"https:\/\/travel-dealz.de\/abflug\/luxemburg-lux\/","name":"Luxemburg [LUX]","slug":"luxemburg-lux","taxonomy":"origins","parent":2984,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2985","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2984"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2985"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2985"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2985"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2985"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":40041,"count":78,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/kiel\/","name":"Kiel","slug":"kiel","taxonomy":"origins","parent":0,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/40041","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=40041"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=40041"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=40041"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=40041"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":3002,"count":76,"description":"Stockholm-Arlanda (ARN) ist der gr\u00f6\u00dfte Flughafen Schwedens und Drehkreuz f\u00fcr SAS und Norwegian (sowie TUIfly Nordic). Der Flughafen ist von allen gro\u00dfen Flugh\u00e4fen Europas erreichbar, zudem gibt es zahlreiche Inlandsfl\u00fcge. Langstrecken verbinden Stockholm mit Nordamerika, Afrika, dem Nahen Osten und Asien.\r\n\r\n<strong>Tipp<\/strong>: Falls ihr am Flughafen \u00fcbernachten m\u00fcsst oder wollt, ist das <a href=\"https:\/\/travel-dealz.de\/blog\/jumbo-stay-stockholm\/\">Jumbo Stay<\/a> ein hei\u00dfer Tipp! Dort \u00fcbernachtet ihr in einer alten, zu einem Hostel umgebauten, Boeing 747!\r\n\r\nAuch vom D-A-CH-Raum ist Stockholm-Arlanda sehr gut erreichbar. Direktfl\u00fcge gibt es von SAS, Norwegian, Easyjet, Eurowings, Lufthansa, Swiss und Austrian. Eine \u00dcbersicht aller Flugverbindungen erhaltet ihr bei <a href=\"https:\/\/www.flightconnections.com\/flights-from-stockholm-arlanda-arn\" target=\"_blank\" rel=\"noopener\">FlightConnections.com<\/a> oder in der <a href=\"https:\/\/en.wikipedia.org\/wiki\/Stockholm_Arlanda_Airport#Passenger\" target=\"_blank\" rel=\"noopener\">englischsprachigen Wikipedia<\/a>. Buchen k\u00f6nnt ihr die Zubringer beispielsweise \u00fcber die <a href=\"https:\/\/travel-dealz.de\/flugsuche\/\" target=\"_blank\" rel=\"noopener\">Travel-Dealz-Flugsuche<\/a>.\r\n\r\nBitte beachtet, dass einige Billigflieger nicht den Flughafen Arlanda (ARN), sondern Stockholm-Skavsta (NYO) anfliegen. Zum Transfer nach Arlanda ist eine knapp zweist\u00fcndige Fahrt mit dem Auto notwendig, Bus und Zug sind sogar zweieinhalb Stunden unterwegs.\r\n\r\nFalls ihr es nicht eilig habt, k\u00f6nnt ihr auch einen Blick auf folgende Optionen zur Anreise werfen:\r\n<ul>\r\n \t<li><a href=\"https:\/\/www.awin1.com\/cread.php?awinmid=14964&amp;awinaffid=135115&amp;p=https%3A%2F%2Fwww.bahn.de%2Fp%2Fview%2Fangebot%2Fsparpreis-europa%2Fschweden.shtml\" target=\"_blank\" rel=\"noopener nofollow sponsored\">Sparpreis Schweden der Deutschen Bahn<\/a> ab 57\u20ac je Richtung. Fahrtzeit: mindestens 9 Stunden<\/li>\r\n \t<li><a href=\"https:\/\/www.snalltaget.se\/en\" target=\"_blank\" rel=\"noopener\">Nachtzug\u00a0<\/a> von Berlin ab 50\u20ac je Richtung. Fahrtzeit: 19 Stunden. Im Schlaf- bzw. Liegewagen allerdings deutlich teurer.<\/li>\r\n \t<li>F\u00e4hre nach Trelleborg \/ Ystad und weiter mit der <a href=\"https:\/\/www.sj.se\/en\/home.html#\/\" target=\"_blank\" rel=\"noopener\">Schwedischen Bahn<\/a>. Dauer: Mindestens 8 Stunden, Gesamtpreis ab ca. 50\u20ac.<\/li>\r\n<\/ul>","link":"https:\/\/travel-dealz.de\/abflug\/stochholm-arn\/","name":"Stockholm [ARN]","slug":"stochholm-arn","taxonomy":"origins","parent":3001,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/3002","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/3001"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=3002"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=3002"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=3002"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=3002"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2997,"count":74,"description":"Mailand ist die zweitgr\u00f6\u00dfte Stadt Italiens. Mit Malpensa, Linate und Bergamo verf\u00fcgt sie \u00fcber gleich drei gro\u00dfe Flugh\u00e4fen. Der bedeutendste von ihnen ist Mailand Malpensa <code>MXP<\/code> mit rund 30 Millionen Passagieren j\u00e4hrlich.\r\n\r\nVor allem von den Billigfliegern wird Malpensa gut mit dem Rest Europas vernetzt. Au\u00dferdem gibt es Langstrecken nach Nord- und S\u00fcdamerika, Asien, Afrika und in den Nahen Osten.\r\n\r\nAb dem D-A-CH-Raum erreicht ihr Malpensa mit Austrian, Easyjet, Eurowings, Luftansa, Neos, Ryanair, Swiss und Wizz Air. Eine \u00dcbersicht aller Verbindungen findet ihr in der <a href=\"https:\/\/en.wikipedia.org\/wiki\/Milan_Malpensa_Airport#Airlines_and_destinations\" target=\"_blank\" rel=\"noopener\">englischsprachigen Wikipedia<\/a> oder bei <a href=\"https:\/\/www.flightradar24.com\/data\/airports\/mxp\/routes\" target=\"_blank\" rel=\"noopener\">Flightradar24<\/a>. Buchen k\u00f6nnt ihr die Fl\u00fcge z.B. \u00fcber die <a href=\"https:\/\/travel-dealz.de\/flugsuche\/\" target=\"_blank\" rel=\"noopener\">Travel-Dealz-Flugsuche<\/a>.\r\n\r\nFalls vom Flughafen eurer Wahl keine Fl\u00fcge nach Malpensa angeboten werden, lohnt sich auch ein Blick auf Verbindungen nach Linate oder Bergamo.\r\n\r\nAlternativ bietet sich vor allem aus der Schweiz und S\u00fcddeutschland auch die Reise mit der Bahn an. Schlie\u00dflich liegt der Flughafen Malpensa gerade einmal 30 km von der Schweizerischen Grenze entfernt. Ab Z\u00fcrich gelangt ihr mit den <a href=\"https:\/\/www.sbb.ch\/\" target=\"_blank\" rel=\"noopener\">SBB<\/a> in unter 4 Stunden nach Malpensa. Von Deutschland aus dauert eine Fahrt nach mindestens 5 Stunden, Tickets erhaltet ihr bei der <a href=\"https:\/\/travel-dealz.de\/go\/bahn\" target=\"_blank\" rel=\"noopener nofollow sponsored\">Deutschen Bahn<\/a>.","link":"https:\/\/travel-dealz.de\/abflug\/mailand-mxp\/","name":"Mailand-Malpensa [MXP]","slug":"mailand-mxp","taxonomy":"origins","parent":0,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2997","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2997"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2997"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2997"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2997"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2949,"count":62,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/dresden-drs\/","name":"Dresden [DRS]","slug":"dresden-drs","taxonomy":"origins","parent":2981,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2949","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2981"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2949"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2949"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2949"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2949"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":3004,"count":62,"description":"Der Flughafen Oslo-Gardermoen ist Norwegens wichtigster Flughafen. Entsprechend wird er von fast allen Fluggesellschaften Europas angeflogen. Es gibt zudem Langstrecken nach Nordamerika und in den Nahen Osten.\r\n\r\nSAS, Norwegian, Eurowings Lufthansa, Swiss und Austrian verbinden Oslo mit den gr\u00f6\u00dftem Flugh\u00e4fen im D-A-CH-Raum. Billigflieger fliegen in der Regel den Flughafen Torp an, der fast zwei Stunden von der Stadt entfernt liegt.\r\n\r\nEine \u00dcbersicht aller Flugverbindungen von und nach Oslo erhaltet ihr in der <a href=\"https:\/\/en.wikipedia.org\/wiki\/Oslo_Airport,_Gardermoen#Passenger\" target=\"_blank\" rel=\"noopener\">englischsprachigen Wikipedia<\/a> oder auf <a href=\"https:\/\/www.flightconnections.com\/flights-from-oslo-osl\" target=\"_blank\" rel=\"noopener\">Flightconnections.com<\/a>. Buchen k\u00f6nnt ihr dann zum Beispiel \u00fcber unsere <a href=\"https:\/\/travel-dealz.de\/flugsuche\/\" target=\"_blank\" rel=\"noopener\">Flugsuche<\/a>.","link":"https:\/\/travel-dealz.de\/abflug\/oslo-osl\/","name":"Oslo [OSL]","slug":"oslo-osl","taxonomy":"origins","parent":3003,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/3004","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/3003"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=3004"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=3004"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=3004"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=3004"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":3145,"count":62,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/madrid-mad\/","name":"Madrid [MAD]","slug":"madrid-mad","taxonomy":"origins","parent":3144,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/3145","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/3144"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=3145"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=3145"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=3145"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=3145"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":3405,"count":61,"description":"Stra\u00dfburg liegt direkt hinter der Deutsch-Franz\u00f6sischen-Grenze und ist daher besonders f\u00fcr Einwohner S\u00fcdwestdeutschlands ein sehr interessanter Ausgangsort f\u00fcr g\u00fcnstige Tickets. Die Fahrt vom Bahnhof Stra\u00dfburg zum Flughafen <code>SXB<\/code> dauert gerade einmal 10 Minuten und kostet rund 5\u20ac.\r\n\r\nBei der <a href=\"https:\/\/travel-dealz.de\/go\/bahn\" target=\"_blank\" rel=\"noopener nofollow sponsored\">Deutschen Bahn<\/a> k\u00f6nnt ihr euch mit nur wenigen Klicks ein Ticket von Deutschland nach Stra\u00dfburg buchen, tlw. sogar direkt bis zum Flughafen. Den Flughafen erreicht ihr ab z.B. Karlsruhe, Freiburg oder Stuttgart in weniger als zwei Stunden. Ab Karlsruhe, Stuttgart, W\u00fcrzburg, ... k\u00f6nnt ihr auch mit dem <a href=\"https:\/\/travel-dealz.de\/go\/flixbus\" target=\"_blank\" rel=\"noopener nofollow sponsored\">Flixbus<\/a> nach Stra\u00dfburg reisen - und zwar ab nur 7\u20ac oneway. Nat\u00fcrlich ist auch die Anfahrt mit dem eigenen PKW eine\u00a0 Option.\r\n\r\nFalls ihr mit dem Flugzeug nach Stra\u00dfburg anreisen wollt, sieht es schlecht aus. Im D-A-CH-Raum bietet ausschlie\u00dflich die Lufthansa einen Direktflug ab M\u00fcnchen an. Eine \u00dcbersicht aller Verbindungen gibt es in der <a href=\"https:\/\/en.wikipedia.org\/wiki\/Strasbourg_Airport#Airlines_and_destinations\" target=\"_blank\" rel=\"noopener\">englischsprachigen Wikipedia<\/a>, buchen k\u00f6nnt ihr dann \u00fcber unsere <a href=\"https:\/\/travel-dealz.de\/flugsuche\/\" target=\"_blank\" rel=\"noopener\">Flugsuche<\/a>.\r\n\r\nLufthansa bietet von Stra\u00dfburg nach Frankfurt\/Main eine eigene Fernbus-Verbindung an. Dieser wird wie ein Flug durchgef\u00fchrt deswegen muss man unbedingt bis 15 Minuten vor Abfahrt online einchecken und die Bordkarte ausgedruckt oder auf dem Smartphone vorzeigen k\u00f6nnen. L\u00e4sst man die Busfahrt verfallen, verf\u00e4llt auch der Anschlussflug.","link":"https:\/\/travel-dealz.de\/abflug\/strassburg\/","name":"Stra\u00dfburg [SXB]","slug":"strassburg","taxonomy":"origins","parent":25318,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/3405","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/25318"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=3405"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=3405"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=3405"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=3405"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":3614,"count":58,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/lissabon-flughafen\/","name":"Lissabon [LIS]","slug":"lissabon-flughafen","taxonomy":"origins","parent":3613,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/3614","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/3613"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=3614"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=3614"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=3614"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=3614"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2937,"count":56,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/deutschland\/","name":"Deutschland","slug":"deutschland","taxonomy":"origins","parent":0,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2937","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2937"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2937"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2937"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2937"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2991,"count":55,"description":"Der V\u00e1clav-Havel-Flughafen Prag ist der mit Abstand gr\u00f6\u00dfte Flughafen in der Tschechischen Republik. Angeboten werden vor allem Fl\u00fcge zu verschiedenen Europazielen und in den Nahen Osten, dazu kommen ein paar Verbindungen nach Asien.\r\n\r\nAb dem D-A-CH-Raum wird der Flughafen Prag von Lufthansa, Eurowings, Easyjet, Swiss und Austrian angeflogen. Eine aktuelle \u00dcbersicht aller Flugverbindungen von und nach Prag findet ihr in der <a href=\"https:\/\/en.wikipedia.org\/wiki\/V%C3%A1clav_Havel_Airport_Prague#Passenger\" target=\"_blank\" rel=\"noopener\">englischsprachigen Wikipedia<\/a> oder auf <a href=\"https:\/\/www.flightconnections.com\/flights-from-prague-prg\" target=\"_blank\" rel=\"noopener\">FlightConnections.com<\/a>. Buchen k\u00f6nnt ihr die Zubringer dann z. B. \u00fcber die <a href=\"https:\/\/travel-dealz.de\/flugsuche\/\" target=\"_blank\" rel=\"noopener\">Travel-Dealz-Flugsuche<\/a>.\r\n\r\nDa der Flughafen Prag nur 80 km von der deutschen Grenze entfernt liegt, ist auch die Anreise \u00fcber Stra\u00dfe und Schiene bequem machbar. Dazu habt ihr unter anderem folgende Optionen:\r\n<ul>\r\n \t<li>Bahn:\r\n<ul>\r\n \t<li><a href=\"https:\/\/www.awin1.com\/cread.php?awinmid=14964&amp;awinaffid=135115&amp;p=https%3A%2F%2Fwww.bahn.de%2Freisen%2Fview%2Fverbindung%2Fprag.shtml\" target=\"_blank\" rel=\"noopener nofollow sponsored\">DB Sparpreis Tschechien<\/a>, z.B. von Dresden ab 13,90\u20ac (2h 30min) oder von Berlin ab 18,90\u20ac (4h 20min)<\/li>\r\n \t<li><a href=\"https:\/\/tickets.oebb.at\/de\/ticket\/timetable\" target=\"_blank\" rel=\"noopener\">\u00d6BB Sparschiene<\/a>, z.B. von Wien ab 14,90\u20ac (4h 30min)<\/li>\r\n<\/ul>\r\n<\/li>\r\n \t<li>Fernbus:\r\n<ul>\r\n \t<li><a href=\"https:\/\/travel-dealz.de\/go\/flixbus\" target=\"_blank\" rel=\"noopener nofollow sponsored\">Flixbus<\/a>, z.B. von Dresden ab 11,90\u20ac (2h)<\/li>\r\n \t<li><a href=\"https:\/\/www.eurolines.de\/de\/internationale-fernbusse\/europabus\/bus-nach-prag\/\">Eurolines<\/a>, z.B. von N\u00fcrnberg ab 9,20\u20ac (5h)<\/li>\r\n<\/ul>\r\n<\/li>\r\n<\/ul>","link":"https:\/\/travel-dealz.de\/abflug\/prag-prg\/","name":"Prag [PRG]","slug":"prag-prg","taxonomy":"origins","parent":2990,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2991","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2990"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2991"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2991"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2991"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=2991"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":40064,"count":55,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/miami\/","name":"Miami","slug":"miami","taxonomy":"origins","parent":0,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/40064","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origin