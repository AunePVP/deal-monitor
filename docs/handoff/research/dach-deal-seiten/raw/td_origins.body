:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2996"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=39740"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=39740"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=39740"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=39740"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":40131,"count":11,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/sydney\/","name":"Sydney [SYD]","slug":"sydney","taxonomy":"origins","parent":40130,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/40131","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/40130"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=40131"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=40131"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=40131"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=40131"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":3784,"count":10,"description":"Der Flughafen Stettin-Goleni\u00f3w liegt 50km \u00f6stlich der deutsch-polnischen Grenze und ist somit nur eine Autostunde von z. B. Schwedt\/Oder oder Prenzlau entfernt.\r\n\r\nWer nicht mit dem Auto anreisen m\u00f6chte, kommt wie folgt nach Stettin:\r\n<ul>\r\n \t<li>Mit der <a href=\"https:\/\/travel-dealz.de\/go\/bahn\" target=\"_blank\" rel=\"noopener nofollow sponsored\">Deutschen Bahn<\/a>:\r\n<ul>\r\n \t<li>Von Pasewalk: Ab 12\u20ac, Fahrtzeit ca. 40min<\/li>\r\n \t<li>Von Berlin\/Brandenburg: 33\u20ac mit dem <a href=\"https:\/\/www.awin1.com\/cread.php?awinmid=14964&amp;awinaffid=135115&amp;p=https%3A%2F%2Fwww.bahn.de%2Fp%2Fview%2Fangebot%2Fregio%2Fregionale-tickets%2Fberlin_brbg%2Fbrandenburg-berlin-ticket.shtml\" target=\"_blank\" rel=\"noopener nofollow sponsored\">Brandenburg-Berlin-Ticket<\/a>, Festpreis f\u00fcr bis zu 5 Personen. Fahrtzeit ab Berlin ca. 2h<\/li>\r\n \t<li>Von Mecklenburg-Vorpommern: Ab 23\u20ac mit dem <a href=\"https:\/\/www.awin1.com\/cread.php?awinmid=14964&amp;awinaffid=135115&amp;p=https%3A%2F%2Fwww.bahn.de%2Fp%2Fview%2Fangebot%2Fregio%2Fregionale-tickets%2Fmeckpomm%2Fmecklenburg-vorpommern-ticket.shtml\" target=\"_blank\" rel=\"noopener nofollow sponsored\">MV-Ticket<\/a> (Preis sinkt bei mehreren Personen auf bis zu 7\u20ac p.P.,)<\/li>\r\n<\/ul>\r\n<\/li>\r\n \t<li>Mit dem <a href=\"https:\/\/travel-dealz.de\/go\/flixbus\" target=\"_blank\" rel=\"noopener nofollow sponsored\">Flixbus<\/a>:\r\n<ul>\r\n \t<li>Von Berlin ab 8\u20ac, Fahrtzeit ca. 2h 30min<\/li>\r\n<\/ul>\r\n<\/li>\r\n<\/ul>\r\nVom Stettiner Hauptbahnhof m\u00fcsst ihr dann noch zum Flughafen kommen. Dazu bietet sich die Regionalbahn an, die die Strecke in 40 Minuten zur\u00fccklegt. Sie kostet nur [c]13 PLN[\/c], verkehrt aber leider auch nur unregelm\u00e4\u00dfig. F\u00fcr ein Taxi muss mit ca. [c]150 PLN[\/c] gerechnet werden.","link":"https:\/\/travel-dealz.de\/abflug\/stettin\/","name":"Stettin [SZZ]","slug":"stettin","taxonomy":"origins","parent":2992,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/3784","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2992"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=3784"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=3784"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=3784"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=3784"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":3803,"count":10,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/erfurt\/","name":"Flughafen Erfurt-Weimar [ERF]","slug":"erfurt","taxonomy":"origins","parent":2937,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/3803","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"up":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2937"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=3803"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=3803"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=3803"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?origins=3803"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2970,"count":9,"description":"","link":"https:\/\/travel-dealz.de\/abflug\/schweiz\/","name":"Schweiz","slug":"schweiz","taxonomy":"origins","parent":0,"meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins\/2970","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/origins"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?origins=2970"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?origins=2970"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?origins=2970"},{"href":"https:\/\