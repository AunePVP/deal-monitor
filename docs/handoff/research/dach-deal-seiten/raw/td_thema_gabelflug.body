ourne International Airport&quot;,&quot;location&quot;:&quot;Melbourne&quot;,&quot;country&quot;:&quot;Australien&quot;,&quot;country_code&quot;:&quot;AU&quot;,&quot;timezone&quot;:&quot;Australia\/Melbourne&quot;,&quot;longitude&quot;:144.843002,&quot;latitude&quot;:-37.673302},&quot;MUC&quot;:{&quot;iatacode&quot;:&quot;MUC&quot;,&quot;icaocode&quot;:&quot;EDDM&quot;,&quot;name&quot;:&quot;M\u00fcnchen Flughafen&quot;,&quot;location&quot;:&quot;M\u00fcnchen&quot;,&quot;country&quot;:&quot;Deutschland&quot;,&quot;country_code&quot;:&quot;DE&quot;,&quot;timezone&quot;:&quot;Europe\/Berlin&quot;,&quot;longitude&quot;:11.7861,&quot;latitude&quot;:48.353802},&quot;PER&quot;:{&quot;iatacode&quot;:&quot;PER&quot;,&quot;icaocode&quot;:&quot;YPPH&quot;,&quot;name&quot;:&quot;Perth International Airport&quot;,&quot;location&quot;:&quot;Perth&quot;,&quot;country&quot;:&quot;Australien&quot;,&quot;country_code&quot;:&quot;AU&quot;,&quot;timezone&quot;:&quot;Australia\/Perth&quot;,&quot;longitude&quot;:115.967003,&quot;latitude&quot;:-31.9403},&quot;SYD&quot;:{&quot;iatacode&quot;:&quot;SYD&quot;,&quot;icaocode&quot;:&quot;YSSY&quot;,&quot;name&quot;:&quot;Sydney Kingsford Smith International Airport&quot;,&quot;location&quot;:&quot;Sydney&quot;,&quot;country&quot;:&quot;Australien&quot;,&quot;country_code&quot;:&quot;AU&quot;,&quot;timezone&quot;:&quot;Australia\/Sydney&quot;,&quot;longitude&quot;:151.177002,&quot;latitude&quot;:-33.946098},&quot;WAW&quot;:{&quot;iatacode&quot;:&quot;WAW&quot;,&quot;icaocode&quot;:&quot;EPWA&quot;,&quot;name&quot;:&quot;Warsaw Chopin Airport&quot;,&quot;location&quot;:&quot;Warsaw&quot;,&quot;country&quot;:&quot;Polen&quot;,&quot;country_code&quot;:&quot;PL&quot;,&quot;timezone&quot;:&quot;Europe\/Warsaw&quot;,&quot;longitude&quot;:20.9671,&quot;latitude&quot;:52.165699},&quot;ZAG&quot;:{&quot;iatacode&quot;:&quot;ZAG&quot;,&quot;icaocode&quot;:&quot;LDZA&quot;,&quot;name&quot;:&quot;Zagreb Airport&quot;,&quot;location&quot;:&quot;Zagreb&quot