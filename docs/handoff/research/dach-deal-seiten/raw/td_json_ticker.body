ility":[],"class_list":["post-472935","ticker","type-ticker","status-publish","has-post-thumbnail","hentry","category-kreuzfahrten","cruiseline-costa-smeralda","region-all","destinations-kanarische-inseln","origins-muenchen-muc","period-dezember"],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker\/472935","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/types\/ticker"}],"author":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/users\/24"}],"replies":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/comments?post=472935"}],"version-history":[{"count":7,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker\/472935\/revisions"}],"predecessor-version":[{"id":486603,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker\/472935\/revisions\/486603"}],"wp:attachment":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/media?parent=472935"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/categories?post=472935"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/tags?post=472935"},{"taxonomy":"airline","embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/airline?post=472935"},{"taxonomy":"cruiseline","embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/cruiseline?post=472935"},{"taxonomy":"region","embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/region?post=472935"},{"taxonomy":"destinations","embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/destinations?post=472935"},{"taxonomy":"origins","embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/origins?post=472935"},{"taxonomy":"period","embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/period?post=472935"},{"taxonomy":"visibility","embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/visibility?post=472935"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":486575,"date":"2026-11-04T09:22:29","date_gmt":"2026-11-04T08:22:29","guid":{"rendered":"https:\/\/travel-dealz.de\/ticker\/486575\/"},"modified":"2026-11-04T09:22:31","modified_gmt":"2026-11-04T08:22:31","slug":"genf-sao-paulo-latam-kommt-in-die-schweiz","status":"publish","type":"ticker","link":"https:\/\/travel-dealz.de\/ticker\/486575\/","title":{"rendered":"Genf &#8211; Sao Paulo: LATAM kommt in die Schweiz"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">Die brasilianische LATAM Airlines plant erstmals Fl\u00fcge in die Schweiz. Ab 28. M\u00e4rz fliegt die Fluggesellschaft dreimal die Woche von Sao Paulo nach Genf und zur\u00fcck. Die Fl\u00fcge dauern ca. 11 bis 12 Stunden je Richtung und werden mit Boeing 787 Dreamlinern durchgef\u00fchrt. <\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Der Flug von Genf nach Sao Paulo erfolgt tags\u00fcber, nur zur\u00fcck geht es als Nachtflug:<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u2022 LA 8080 Sao Paulo <code>GRU<\/code> &#8211; Genf <code>GVA<\/code>: 18:05 &#8211; 09:55 Uhr <sup>(+1)<\/sup><br \/>\u2022 LA 8081 Genf <code>GVA<\/code> &#8211; Sao Paulo <code>GRU<\/code>: 12:05 &#8211; 18:55 Uhr<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Die Fl\u00fcge sind bereits buchbar und kosten <a rel=\"nofollow sponsored noopener\" href=\"https:\/\/go2.travel-dealz.de\/?from=GVA&amp;to=GRU&amp;date_out=2027-04-21&amp;date_in=2027-04-29&amp;oneway=false&amp;cabinclass=Y&amp;direct=true&amp;adults=1&amp;children=0&amp;infants=0\u00a4cy=EUR&amp;destination=skyscanner\">rund 750\u20ac<\/a> in der Economy (zzgl. Gep\u00e4ck). Zuletzt bot der Vorg\u00e4nger TAM in den 2000er Jahren Fl\u00fcge in die Schweiz an (Porto Alegre &#8211; Sao Paulo &#8211; Frankfurt &#8211; Z\u00fcrich).<\/p>\n\n\n\n<p class=\"has-text-align-right wp-block-paragraph\">Quelle: <a href=\"https:\/\/www.latamtrade.com\/en_au\/news\/RUTAS_Nueva_operaciOn_entre_SaoPaulo_Ginebra_ENG\">LATAM<\/a> | Danke ans <a href=\"https:\/\/forum.travel-dealz.de\/t\/new-latam-flight-gva-gru\/15808\">Travel-Dealz Forum<\/a><\/p>\n<p><aside class=\"affiliate-marker-disclosure\">* Was der Stern bedeutet: F\u00fcr Links, die mit einem Asterisk markiert sind, erhalten wir eine Provision, wenn \u00fcber den verlinkten Anbieter eine Buchung oder eine bestimmte Aktion zustande kommt. F\u00fcr Euch entstehen dadurch keine Mehrkosten. F\u00fcr das reine Setzen des Links erhalten wir kein Geld.<\/aside><\/p>","protected":false},"excerpt":{"rendered":"<p>Die brasilianische LATAM Airlines plant erstmals Fl\u00fcge in die Schweiz. Ab 28. M\u00e4rz fliegt die Fluggesellschaft dreimal die Woche von Sao Paulo nach Genf und zur\u00fcck. Die Fl\u00fcge dauern ca. 11 bis 12 Stunden je Richtung und werden mit Boeing 787 Dreamlinern durchgef\u00fchrt. Der Flug von Genf nach Sao Paulo erfolgt tags\u00fcber, nur zur\u00fcck geht [&hellip;]<\/p>\n","protected":false},"author":5,"featured_media":250032,"comment_status":"open","ping_status":"closed","template":"","meta":{"trello_card_id":"","suspend_date":"2027-01-06 23:59:00","suspend_unkown":false,"post_push_at":[],"suspend_fare_check":"","footnotes":""},"categories":[1],"tags":[40833],"airline":[2798],"cruiseline":[],"region":[19080],"destinations":[],"origins":[],"period":[],"visibility":[],"class_list":["post-486575","ticker","type-ticker","status-publish","has-post-thumbnail","hentry","category-allgemein","tag-strecken-news","airline-latam","region-all"],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker\/486575","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/types\/ticker"}],"author":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v