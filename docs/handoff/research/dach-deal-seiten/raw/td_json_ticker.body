[{"id":486604,"date":"2026-11-04T11:37:46","date_gmt":"2026-11-04T10:37:46","guid":{"rendered":"https:\/\/travel-dealz.de\/ticker\/486604\/"},"modified":"2026-11-04T11:40:54","modified_gmt":"2026-11-04T10:40:54","slug":"china-eastern-gabelfluege-amsterdam-tokio-frankfurt-ab-426e-inkl-gepaeck-nov-dez-2026","status":"publish","type":"ticker","link":"https:\/\/travel-dealz.de\/ticker\/486604\/","title":{"rendered":"China Eastern: Gabelfl\u00fcge Amsterdam &#8211; Tokio &#8211; Frankfurt ab 426\u20ac (Nov. \/ Dez. 2026)"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">Mit China Eastern k\u00f6nnt ihr gerade ab nur 426\u20ac nach Tokio und zur\u00fcck fliegen. Dazu m\u00fcsst ihr das Ganze als Gabelflug buchen, etwa hin von Amsterdam und zur\u00fcck nach Frankfurt. Die Preise enthalten bereits 2x 23 kg Aufgabegep\u00e4ck.<\/p>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" rel=\"nofollow sponsored noopener\" href=\"https:\/\/go2.travel-dealz.de\/?type=flights&amp;from%5B0%5D=AMS&amp;to%5B0%5D=TYO&amp;date_out%5B0%5D=2026-12-02&amp;from%5B1%5D=TYO&amp;to%5B1%5D=FRA&amp;date_out%5B1%5D=2026-12-14&amp;oneway=true&amp;cabinclass=Y&amp;direct=false&amp;adults=1&amp;children=0&amp;infants=0&amp;currency=EUR&amp;destination=skyscanner\">Zum Deal<\/a><\/div>\n<\/div>\n\n\n\n<p class=\"wp-block-paragraph\">Die Verf\u00fcgbarkeiten sind sehr \u00fcberschaubar. Der Abflug ist wohl nur an wenigen Tagen im November und Dezember m\u00f6glich. Drei Beispiele:<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u2022 30. November bis 9. Dezember <a rel=\"nofollow sponsored noopener\" href=\"https:\/\/go2.travel-dealz.de\/?type=flights&amp;from%5B0%5D=AMS&amp;to%5B0%5D=TYO&amp;date_out%5B0%5D=2026-11-30&amp;from%5B1%5D=TYO&amp;to%5B1%5D=FRA&amp;date_out%5B1%5D=2026-12-09&amp;oneway=true&amp;cabinclass=Y&amp;direct=false&amp;adults=1&amp;children=0&amp;infants=0\u00a4cy=EUR&amp;destination=skyscanner\">ab 426\u20ac<\/a><br \/>\u2022 1. bis 15. Dezember <a rel=\"nofollow sponsored noopener\" href=\"https:\/\/go2.travel-dealz.de\/?type=flights&amp;from%5B0%5D=AMS&amp;to%5B0%5D=TYO&amp;date_out%5B0%5D=2026-12-01&amp;from%5B1%5D=TYO&amp;to%5B1%5D=FRA&amp;date_out%5B1%5D=2026-12-15&amp;oneway=true&amp;cabinclass=Y&amp;direct=false&amp;adults=1&amp;children=0&amp;infants=0\u00a4cy=EUR&amp;destination=skyscanner\">ab 428\u20ac<\/a><br \/>\u2022 2. bis 14. Dezember <a rel=\"nofollow sponsored noopener\" href=\"https:\/\/go2.travel-dealz.de\/?type=flights&amp;from%5B0%5D=AMS&amp;to%5B0%5D=TYO&amp;date_out%5B0%5D=2026-12-02&amp;from%5B1%5D=TYO&amp;to%5B1%5D=FRA&amp;date_out%5B1%5D=2026-12-14&amp;oneway=true&amp;cabinclass=Y&amp;direct=false&amp;adults=1&amp;children=0&amp;infants=0\u00a4cy=EUR&amp;destination=skyscanner\">ab 426\u20ac<\/a><\/p>\n\n\n\n<figure class=\"wp-block-image size-full\"><a rel=\"nofollow sponsored noopener\" href=\"https:\/\/go2.travel-dealz.de\/?type=flights&amp;from%5B0%5D=AMS&amp;to%5B0%5D=TYO&amp;date_out%5B0%5D=2026-12-02&amp;from%5B1%5D=TYO&amp;to%5B1%5D=FRA&amp;date_out%5B1%5D=2026-12-14&amp;oneway=true&amp;cabinclass=Y&amp;direct=false&amp;adults=1&amp;children=0&amp;infants=0&amp;currency=EUR&amp;destination=skyscanner\"><img loading=\"lazy\" decoding=\"async\" width=\"1028\" height=\"278\" src=\"https:\/\/travel-dealz.de\/app\/uploads\/sites\/2\/amstyofra-426.png\" alt=\"amstyofra 426\" class=\"wp-image-486606\" srcset=\"https:\/\/travel-dealz.de\/app\/uploads\/sites\/2\/amstyofra-426.png 1028w, https:\/\/travel-dealz.de\/app\/uploads\/sites\/2\/amstyofra-426-300x81.png 300w, https:\/\/travel-dealz.de\/app\/uploads\/sites\/2\/amstyofra-426-840x227.png 840w, https:\/\/travel-dealz.de\/app\/uploads\/sites\/2\/amstyofra-426-180x49.png 180w\" sizes=\"auto, (max-width: 1028px) 100vw, 1028px\" \/><\/a><\/figure>\n\n\n\n<p class=\"has-text-align-right wp-block-paragraph\">Quelle: <a href=\"https:\/\/travelfree.info\/open-jaw-flights-amsterdam-tokyo\/\">Travelfree<\/a><\/p>\n<p><aside class=\"affiliate-marker-disclosure\">* Was der Stern bedeutet: F\u00fcr Links, die mit einem Asterisk markiert sind, erhalten wir eine Provision, wenn \u00fcber den verlinkten Anbieter eine Buchung oder eine bestimmte Aktion zustande kommt. F\u00fcr Euch entstehen dadurch keine Mehrkosten. F\u00fcr das reine Setzen des Links erhalten wir kein Geld.<\/aside><\/p>","protected":false},"excerpt":{"rendered":"<p>Mit China Eastern k\u00f6nnt ihr gerade ab nur 426\u20ac nach Tokio und zur\u00fcck fliegen. Dazu m\u00fcsst ihr das Ganze als Gabelflug buchen, etwa hin von Amsterdam und zur\u00fcck nach Frankfurt. Die Preise enthalten bereits 2x 23 kg Aufgabegep\u00e4ck. Die Verf\u00fcgbarkeiten sind sehr \u00fcberschaubar. Der Abflug ist wohl nur an wenigen Tagen im November und Dezember [&hellip;]<\/p>\n","protected":false},"author":5,"featured_media":245005,"comment_status":"open","ping_status":"closed","template":"","meta":{"trello_card_id":"","suspend_date":"2026-11-08 23:59:00","suspend_unkown":false,"post_push_at":[],"suspend_fare_check":"","footnotes":""},"categories":[1757],"tags":[763],"airline":[2463],"cruiseline":[],"region":[19080],"destinations":[295],"origins":[2961],"period":[19098,19097],"visibility":[],"class_list":["post-486604","ticker","type-ticker","status-publish","has-post-thumbnail","hentry","category-economy-class","tag-gabelflug","airline-china-eastern-airlines","region-all","destinations-tokio","origins-amsterdam-schiphol-ams","period-dezember","period-november"],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker\/486604","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/types\/ticker"}],"author":[{"embeddable":true,"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/users\/5"}],"replies":[{"embeddable":true,"href":"https:\