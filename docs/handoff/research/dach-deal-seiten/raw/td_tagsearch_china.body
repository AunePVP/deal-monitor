[{"id":2782,"count":3,"description":"PhoenixMiles ist das Vielfliegerprogramm der chinesischen Fluggesellschaft Air China welche Mitglied der Star Alliance ist. Das Programm ist entfernungsbasiert. Je nach Buchungsklasse kann man zwischen 25% und 300% Entfernungskilometer auf Fl\u00fcgen mit Air China sammeln.\r\nAb 40.000 Kilometern gibt es den Silver und ab 80.000 Kilometern den Gold Status. Der Gold Status ist gleichzeitig ein Star Alliance Gold Status.","link":"https:\/\/travel-dealz.de\/thema\/air-china-phoenixmiles\/","name":"Air China PhoenixMiles","slug":"air-china-phoenixmiles","taxonomy":"post_tag","meta":[],"_links":{"self":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/tags\/2782","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/tags"}],"about":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/taxonomies\/post_tag"}],"wp:post_type":[{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/posts?tags=2782"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/article?tags=2782"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/news?tags=2782"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/deal?tags=2782"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/ticker?tags=2782"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/coupon?tags=2782"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/podcast?tags=2782"},{"href":"https:\/\/travel-dealz.de\/wp-json\/wp\/v2\/pages?tags=2782"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}]