		<item>
		<title>Neue Flying Blue Promo Rewards: Für 45.000 Meilen in der Air France Business Class nach New York</title>
		<link>https://frankfurtflyer.de/flying-blue-promo-rewards/</link>
					<comments>https://frankfurtflyer.de/flying-blue-promo-rewards/#comments</comments>
		
		<dc:creator><![CDATA[Robert]]></dc:creator>
