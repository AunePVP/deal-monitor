		<dc:creator><![CDATA[Christoph]]></dc:creator>
		<pubDate>Sun, 01 Nov 2026 07:30:30 +0000</pubDate>
				<category><![CDATA[Allgemein]]></category>
		<category><![CDATA[Dubai Flugverkehr 2026]]></category>
		<category><![CDATA[Emirates]]></category>
