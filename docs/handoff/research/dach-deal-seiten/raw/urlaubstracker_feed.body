					<comments>https://www.urlaubstracker.de/deutschland-muenchen-ibis-city-sued/#respond</comments>
		
		<dc:creator><![CDATA[Michael]]></dc:creator>
		<pubDate>Wed, 04 Nov 2026 20:30:03 +0000</pubDate>
				<category><![CDATA[Hotel]]></category>
		<category><![CDATA[Deutschland]]></category>
		<category><![CDATA[Dezember]]></category>
