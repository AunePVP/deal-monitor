	<item>
		<title>Traumziel Kap Verde: 8 Tage Strandurlaub im 4* Hotel inkl. Frühstück, Flug, Zug &#038; Transfer ab 886 €</title>
		<link>https://www.urlaubstracker.de/kap-verden-hotel-sobrado/</link>
					<comments>https://www.urlaubstracker.de/kap-verden-hotel-sobrado/#respond</comments>
		
		<dc:creator><![CDATA[Michael]]></dc:creator>
		<pubDate>Wed, 04 Nov 2026 21:30:02 +0000</pubDate>
				<category><![CDATA[Reisen]]></category>
		<category><![CDATA[Afrika]]></category>
		<category><![CDATA[Dezember]]></category>
		<category><![CDATA[Kap Verde]]></category>
