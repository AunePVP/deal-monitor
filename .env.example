# Deal-Monitor – optionale Einstellungen per Umgebungsvariable
# =============================================================
# Datei nach ".env" kopieren und nur die Zeilen einkommentieren, die du brauchst.
#   cp .env.example .env
#
# WICHTIG: Fast alles lässt sich bequemer in der Oberfläche unter "Einstellungen"
# eintragen. Was hier gesetzt ist, gewinnt immer und ist in der Oberfläche gesperrt
# ("per Umgebungsvariable gesetzt"). Format: NAME=wert (ohne Leerzeichen um "=").

# --- Zugriff ---------------------------------------------------------------
# Passwort für die Web-Oberfläche (HTTP Basic Auth, Benutzername egal).
# Unbedingt setzen, wenn der Monitor im Netz/Internet erreichbar ist.
#DEALMONITOR_PASSWORD=

# Nur ohne Docker (./start.sh): Adresse und Port des Servers.
# Bei Docker den Port in docker-compose.yml unter "ports" ändern.
#DEALMONITOR_HOST=127.0.0.1
#DEALMONITOR_PORT=8080
# Datenverzeichnis (Datenbank). Standard: ./data (Docker: /data)
#DEALMONITOR_DATA=
#
# Zusätzliche Hostnamen, unter denen die Oberfläche aufgerufen wird (kommagetrennt).
# Ohne Eintrag funktionieren nur localhost und IP-Adressen (z. B. http://192.168.1.20:8080) –
# das schützt vor fremden Webseiten (DNS-Rebinding). Für http://nas.local:8080 oder einen
# Reverse-Proxy mit eigener Domain hier den Namen eintragen, z. B. nas.local,deals.example.org
#DEALMONITOR_ALLOWED_HOSTS=
#
# Zeitzone für alle Zeitangaben ("Letzte Prüfung", "gefunden am"). Docker-Standard: Europe/Berlin
#TZ=Europe/Berlin

# --- Preisquelle -------------------------------------------------------------
# Kostenloser API-Token von https://www.travelpayouts.com/ (Tools → API)
#TRAVELPAYOUTS_TOKEN=
# Optional: Partner-Marker für die Buchungslinks
#TRAVELPAYOUTS_MARKER=
# Aktive Quellen, kommagetrennt: travelpayouts,feed
#SOURCES=travelpayouts,feed

# --- Zeitplan ----------------------------------------------------------------
# Alle wie viele Stunden automatisch geprüft wird (mindestens 0.5)
#INTERVAL_HOURS=3
# Wie viele Abflugmonate im Voraus gesucht wird (1–12)
#SCAN_MONTHS=6

# --- Benachrichtigungen ------------------------------------------------------
# Die Meldungen in der Oberfläche sind immer aktiv. Zusätzlich:
#
# Eigener Benachrichtigungsserver (oder Slack/Discord/n8n): POST mit JSON
#WEBHOOK_URL=
# Optional: wird als "Authorization: Bearer <token>" mitgeschickt
#WEBHOOK_TOKEN=
#
# Push aufs Handy per ntfy (App "ntfy", Topic frei wählbar, schwer zu erraten!)
#NTFY_TOPIC=
#NTFY_SERVER=https://ntfy.sh
#
# Telegram-Bot (Token von @BotFather, Chat-ID z. B. über @userinfobot)
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# --- Erweitert ---------------------------------------------------------------
# Währung (dreistelliger Code)
#CURRENCY=eur
# Preis-Historie in Tagen für den Referenzpreis (Median)
#HISTORY_DAYS=60
# Ab so vielen eigenen Preisbeobachtungen gilt der Median statt des Normalpreises
#MIN_HISTORY_SAMPLES=8
# Erneut melden, wenn der Preis um diesen Anteil fällt (0.05 = 5 %)
#RENOTIFY_DROP=0.05
# Höchstens so viele Meldungen pro Alarm und Lauf
#MAX_DEALS_PER_ALERT=5
# Pause zwischen API-Anfragen in Sekunden
#REQUEST_DELAY=0.35
# RSS-Feeds, kommagetrennt
#FEEDS=https://travel-dealz.de/feed/
# Feed-Artikel älter als so viele Tage ignorieren
#FEED_MAX_AGE_DAYS=14
