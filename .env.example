# Deal-Monitor – optionale Einstellungen per Umgebungsvariable
# =============================================================
# Datei nach ".env" kopieren und nur die Zeilen einkommentieren, die du brauchst.
#   cp .env.example .env
#
# WICHTIG: Fast alles lässt sich bequemer in der Oberfläche unter "Einstellungen"
# eintragen. Was hier gesetzt ist, gewinnt immer und ist in der Oberfläche gesperrt
# ("per Umgebungsvariable gesetzt"). Format: NAME=wert (ohne Leerzeichen um "=").

# --- Zugriff ---------------------------------------------------------------
# Passwort für die Web-Oberfläche (HTTP Basic Auth, Benutzername egal).
# Unbedingt setzen, wenn der Monitor im Netz/Internet erreichbar ist.
#DEALMONITOR_PASSWORD=

# Nur ohne Docker (./start.sh): Adresse und Port des Servers.
# Bei Docker den Port in docker-compose.yml unter "ports" ändern.
#DEALMONITOR_HOST=127.0.0.1
#DEALMONITOR_PORT=8080
# Datenverzeichnis (Datenbank). Standard: ./data (Docker: /data)
#DEALMONITOR_DATA=
#
# Zusätzliche Hostnamen, unter denen die Oberfläche aufgerufen wird (kommagetrennt).
# Ohne Eintrag funktionieren localhost, IP-Adressen (z. B. http://192.168.1.20:8080) und
# Heimnetz-Namen (tower, nas.local, *.lan, *.fritz.box) – das schützt vor fremden Webseiten
# (DNS-Rebinding). Für einen Reverse-Proxy mit eigener Domain hier den Namen eintragen,
# z. B. deals.example.org
#DEALMONITOR_ALLOWED_HOSTS=
#
# Zeitzone für alle Zeitangaben ("Letzte Prüfung", "gefunden am"). Docker-Standard: Europe/Berlin
#TZ=Europe/Berlin

# --- Quellen -----------------------------------------------------------------
# Aktive Quellen, kommagetrennt: travelpayouts, google_flights, amadeus, feeds
# ("feed" = alter Name für feeds). Standard: travelpayouts,google_flights,feeds
#SOURCES=travelpayouts,google_flights,feeds
#
# Travelpayouts: kostenloser API-Token von https://www.travelpayouts.com/ (Profil → API token; Aviasales-Programm beitreten)
#TRAVELPAYOUTS_TOKEN=
# Optional: Partner-Marker für die Buchungslinks
#TRAVELPAYOUTS_MARKER=
#
# Google Flights (inoffiziell, kein Key): höchstens so viele Abfragen pro Lauf (2–500),
# inkl. Gegenprüfungen (¼ bleibt dafür frei, höchstens die Hälfte). Zwischen Abfragen 2–4 s Pause.
# Der Rest wird gleichmäßig auf die Alarme verteilt. Bei "Jeden Tag einzeln prüfen"
# (Zürich ⇄ Hamburg one-way) dauert eine Runde über 90 Tage mit 40 knapp 4 Tage, mit 120 etwa einen.
#GOOGLE_MAX_REQUESTS=40
# Deals aus gecachten Preisen (Travelpayouts, Amadeus-Monatsscan) bei Google gegenprüfen:
# passender Google-Flug ≤ 25 % teurer und unter der Alarm-Grenze = bestätigt (mit Google-Preis),
# sonst verworfen (true/false)
#GOOGLE_VERIFY=true
#
# Amadeus Self-Service: laut Anbieter am 17.07.2026 eingestellt (neue Keys nur noch für
# Enterprise-Kunden). Nur eintragen, wenn du noch einen gültigen Key hast. Code ungetestet.
#AMADEUS_API_KEY=
#AMADEUS_API_SECRET=
# test = Testumgebung, production = echte Daten
#AMADEUS_ENV=test
# Höchstens so viele Amadeus-Abfragen pro Lauf (1–2000)
#AMADEUS_MAX_REQUESTS=100
#
# Deal-Seiten (Feeds): aktive Presets, kommagetrennt. Möglich: travel-dealz,
# travel-dealz-rest, travel-dealz-suche, secretflying, mydealz-fluege, fly4free,
# fly4free-business, premium-flights, yhbu, urlaubspiraten, reisetopia, errorfarealerts
#FEED_PRESETS=travel-dealz,travel-dealz-rest,travel-dealz-suche,secretflying,mydealz-fluege,fly4free,premium-flights,yhbu,reisetopia
# Zusätzliche eigene RSS-Feeds, kommagetrennt
#FEEDS=https://example.org/feed/,https://example.org/andere/feed/
# Feed-Artikel ohne Ablaufdatum älter als so viele Tage ignorieren (YHBU mind. 45, premium-flights mind. 30)
#FEED_MAX_AGE_DAYS=14
# Nachbar-Hubs (Budapest, Rom, Amsterdam …) bei Business/Langstrecke mit Zubringer zulassen
#HUBS_ENABLED=true
# Geschätzter Aufschlag in € für Zug/Auto (Luxemburg, Amsterdam …) bzw. Zubringerflug (Budapest, Rom …)
#HUB_SURCHARGE_A=80
#HUB_SURCHARGE_B=180

# --- Radar (alle Feed-Artikel auf Hammer-Deals prüfen) ------------------------
# Error Fares/Fehlerpreise werden immer gemeldet, sonst alles unter diesen Grenzen (€)
#RADAR_ENABLED=true
#RADAR_ECONOMY_MAX=300
# Economy darunter ignorieren (Kurzstrecken-Promos wie "ab 14,99 €")
#RADAR_ECONOMY_MIN=40
#RADAR_PREMIUM_MAX=700
#RADAR_BUSINESS_MAX=1300
#RADAR_FIRST_MAX=2500
# Nur Abflug aus Deutschland/Österreich/Schweiz (oder ohne Angabe) - false = auch Amsterdam, Prag …
#RADAR_HOME_ONLY=true
# Economy nur Langstrecke (Europa/Türkei/Nahost nur als Error Fare, Business dorthin nur bis zur
# Economy-Grenze) - false = alle Strecken wie früher
#RADAR_LONG_HAUL_ONLY=true

# --- Zeitplan ----------------------------------------------------------------
# Alle wie viele Stunden automatisch geprüft wird - alle Quellen (mindestens 0.5)
#INTERVAL_HOURS=3
# Alle wie viele Minuten zusätzlich nur die Deal-Seiten + Radar geprüft werden (mindestens 10)
#FEED_INTERVAL_MINUTES=30
# Alle wie viele Minuten die schnellen Deal-Quellen (Secret Flying, Travel-Dealz schnell) (mindestens 5)
#FAST_INTERVAL_MINUTES=10
# Wie viele Abflugmonate im Voraus gesucht wird (1–12)
#SCAN_MONTHS=6

# --- Benachrichtigungen ------------------------------------------------------
# Die Meldungen in der Oberfläche sind immer aktiv. Zusätzlich:
#
# Eigener Benachrichtigungsserver (oder Slack/Discord/n8n): POST mit JSON
#WEBHOOK_URL=
# Optional: wird als "Authorization: Bearer <token>" mitgeschickt
#WEBHOOK_TOKEN=
#
# Push aufs Handy per ntfy (App "ntfy", Topic frei wählbar, schwer zu erraten!)
#NTFY_TOPIC=
#NTFY_SERVER=https://ntfy.sh
#
# Telegram-Bot (Token von @BotFather, Chat-ID z. B. über @userinfobot)
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# --- Erweitert ---------------------------------------------------------------
# Währung (dreistelliger Code)
#CURRENCY=eur
# Preis-Historie in Tagen für den Referenzpreis (Median)
#HISTORY_DAYS=60
# Ab so vielen eigenen Preisbeobachtungen gilt der Median statt des Normalpreises
#MIN_HISTORY_SAMPLES=8
# Erneut melden, wenn der Preis um diesen Anteil fällt (0.05 = 5 %)
#RENOTIFY_DROP=0.05
# Höchstens so viele Meldungen pro Alarm und Lauf
#MAX_DEALS_PER_ALERT=5
# Pause zwischen API-Anfragen in Sekunden
#REQUEST_DELAY=0.35
